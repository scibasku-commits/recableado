	    .route-map li::before{content:counter(route,decimal-leading-zero);font:400 10px/1 var(--mono);color:var(--cyan);margin-right:8px}
	    :root[data-theme='light'] .route-map li::before{color:var(--blue)}
    .course{background:var(--paper);color:var(--ink);margin-inline:calc(50% - 50vw);padding:clamp(48px,8vw,96px) max(clamp(18px,4vw,48px),calc((100vw - 1180px)/2 + 48px))}
