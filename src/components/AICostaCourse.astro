    @keyframes rise{from{opacity:.35;transform:translateY(8px)}to{opacity:1;transform:none}}
	    .module-no{font:700 12px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px}
	    :root[data-theme='light'] .module-no{color:var(--blue)}
    .module h3{font-size:clamp(2.2rem,5vw,4.6rem);line-height:.98;letter-spacing:-.04em;margin:0 0 34px;max-width:12ch}
    .block{padding:24px 0;border-top:1px solid var(--line)}
    :root[data-theme='dark'] .block{border-color:rgba(184,197,214,.25)}
    .block h4{font:700 12px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--blue);margin:0 0 12px}
    :root[data-theme='dark'] .block h4{color:var(--gold)}
    .block p{max-width:68ch;margin:0}
