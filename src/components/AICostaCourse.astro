    .voice-ways{display:grid;grid-template-columns:1fr 1fr}
    .voice-way{padding:24px clamp(20px,4vw,34px)}
    .voice-way+ .voice-way{border-left:1px solid var(--gold)}
    .voice-way strong{display:block;font:700 1.08rem/1.25 var(--display);color:var(--blue);margin-bottom:8px}
    :root[data-theme='dark'] .voice-way strong{color:var(--cyan)}
    .voice-way p{font-size:.96rem;line-height:1.6;margin:0}
    .builder-note{padding:24px clamp(20px,4vw,34px);border-top:1px solid var(--gold);background:var(--line)}
    :root[data-theme='dark'] .builder-note{background:var(--navy)}
    .builder-note p{margin:0;max-width:72ch}
    .case-links{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:18px}
    .case-link{min-height:44px;display:inline-flex;align-items:center;font:700 13px/1.3 var(--display);color:var(--blue);text-underline-offset:.3em}
    :root[data-theme='dark'] .case-link{color:var(--cyan)}
    .prompt{background:var(--blue);color:var(--white);border:1px solid var(--gold);border-radius:14px;overflow:hidden;margin-top:16px}
    .prompt-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border-bottom:1px solid rgba(212,175,55,.5)}
    .prompt-head span{font:700 10px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .copy{min-height:44px;background:var(--cyan);color:var(--navy);border:0;border-radius:10px;padding:8px 12px;cursor:pointer;font:700 11px/1 var(--display)}
    pre{white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:20px;font:400 14px/1.65 var(--mono)}
    .side{align-self:start;position:sticky;top:24px;border-top:1px solid var(--gold);padding-top:22px}
    .side h4{font:700 12px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin:0 0 10px}
    .side p{margin:0 0 24px;font-size:1rem}
    .sources{display:flex;flex-direction:column;gap:8px;margin:0 0 28px}
    .source{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);font:700 13px/1.3 var(--display);text-decoration:none}
    .source::after{content:'↗';color:var(--cyan)}
    .complete{width:100%;min-height:50px;border:1px solid var(--cyan);border-radius:14px;background:transparent;color:inherit;padding:12px;cursor:pointer;font:700 13px/1.2 var(--display)}
    .complete[aria-pressed='true']{background:var(--cyan);color:var(--navy)}
    .module-controls{display:flex;justify-content:space-between;gap:12px;margin-top:36px;padding-top:20px;border-top:1px solid var(--line)}
    .nav-btn{min-height:48px;border:1px solid var(--gold);border-radius:12px;background:transparent;color:inherit;padding:10px 16px;cursor:pointer;font:700 12px/1 var(--display)}
    .nav-btn:disabled{opacity:.35;cursor:not-allowed}
    .sello-scale{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--gold);margin:18px 0}
    .sello-scale div{padding:14px;border-right:1px solid var(--gold)}
    .sello-scale div:last-child{border-right:0;background:var(--cyan);color:var(--navy)}
    .sello-scale strong{display:block;font-family:var(--display)}
    .sello-scale span{font-size:.84rem}
    .closing{padding:clamp(70px,10vw,130px) 0;text-align:center}
    .closing h2{font-size:clamp(2.5rem,6vw,5rem);line-height:.98;letter-spacing:-.04em;margin:0 auto 24px;max-width:15ch}
    .closing p{max-width:56ch;margin:0 auto 28px;color:var(--muted)}
    footer{border-top:1px solid rgba(212,175,55,.55);padding:22px 0 0;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font:400 11px/1.5 var(--mono);color:var(--muted)}
    :root[data-theme='light'] .closing p,:root[data-theme='light'] footer{color:var(--ink)}
    @media(max-width:780px){.hero{grid-template-columns:1fr;min-height:0;padding:72px 0}.module-nav{grid-template-columns:repeat(2,1fr)}.module.is-active{grid-template-columns:1fr}.side{position:static}.course-head{grid-template-columns:1fr}.progress-copy{text-align:left}.voice-ways{grid-template-columns:1fr}.voice-way+ .voice-way{border-left:0;border-top:1px solid var(--gold)}}
    @media(max-width:520px){body{font-size:17px}.shell{padding-inline:18px}.top{align-items:flex-start}.brand{max-width:15ch}.controls{max-width:170px}.control{font-size:0;width:44px;padding:0}.control::after{content:'◐';font-size:17px}.control[data-guidance]::after{content:'?';font-family:var(--display);font-weight:700}.hero-actions{flex-direction:column}.primary,.secondary{width:100%;justify-content:center}.route-map ol{grid-template-columns:1fr}.module-nav{grid-template-columns:1fr 1fr}.module-tab{min-height:58px}.module h3{font-size:2.55rem}.sello-scale{grid-template-columns:1fr}.sello-scale div{border-right:0;border-bottom:1px solid var(--gold)}.sello-scale div:last-child{border-bottom:0}.module-controls{flex-direction:column}.nav-btn{width:100%}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.module.is-active{animation:none}.meter span{transition:none}}
  </style>
</head>
<body data-lang={lang}>
  <div class="shell">
    <header class="top">
      <a class="brand" href={learnPath}>{ui.brand}</a>
      <div class="controls">
        <a class="lang" href={alternatePath} lang={es ? 'en' : 'es'} aria-label={es ? 'Read in English' : 'Leer en español'}>{es ? 'EN' : 'ES'}</a>
        <button class="control" type="button" id="themeToggle" aria-label={ui.theme}>{ui.theme}</button>
        <button class="control" type="button" id="guidanceToggle" data-guidance aria-pressed="false">{ui.guidance}</button>
      </div>
    </header>

    <main>
      <section class="hero">
        <div>
          <p class="gift">{ui.gift}</p>
          <h1>{ui.hero}</h1>
          <p class="intro">{ui.intro}</p>
          <div class="hero-actions">
            <button class="primary" type="button" data-jump="0">{ui.start}</button>
            <button class="secondary" type="button" id="continueButton">{ui.continue}</button>
          </div>
        </div>
        <aside class="route-map" aria-label={ui.menu}>
          <p>{ui.menu}</p>
          <ol>{modules.map((module) => <li>{module.short}</li>)}</ol>
        </aside>
      </section>

      <section class="hero-video" aria-labelledby="hero-video-title">
        <h2 id="hero-video-title">{ui.videoTitle}</h2>
        <p>{ui.videoText}</p>
        <video controls preload="metadata" playsinline poster="/ai-costa-social.png">
          <source src="https://res.cloudinary.com/drqgkirpy/video/upload/v1788609837/recableado/ai-costa-giora-60s.mp4" type="video/mp4" />
        </video>
      </section>

      <section class="course" id="course" aria-labelledby="course-title">
        <div class="course-head">
          <h2 id="course-title">{ui.menu}</h2>
          <div class="progress-copy"><span>{ui.progress}</span> · <strong id="progressCount">0 / {modules.length}</strong> {ui.completed}</div>
        </div>
        <div class="meter" role="progressbar" aria-label={ui.progress} aria-valuemin="0" aria-valuemax={modules.length} aria-valuenow="0"><span></span></div>

        <div class="module-nav" role="tablist" aria-label={ui.menu}>
          {modules.map((module, index) => (
            <button class="module-tab" type="button" role="tab" id={`tab-${index}`} aria-controls={`module-${index}`} aria-selected={index === 0 ? 'true' : 'false'} data-module-tab={index}>
              <span>{ui.route} {String(index + 1).padStart(2, '0')}</span>{module.short}
            </button>
          ))}
        </div>

        {modules.map((module, index) => (
          <article class:list={['module', { 'is-active': index === 0 }]} id={`module-${index}`} role="tabpanel" aria-labelledby={`tab-${index}`} data-module={index} hidden={index !== 0}>
            <div>
              <div class="module-no">{ui.route} {String(index + 1).padStart(2, '0')} · {modules.length}</div>
              <h3>{module.title}</h3>
              <section class="block"><h4>{ui.learn}</h4><p>{module.aim}</p></section>
              <section class="block"><h4>{ui.why}</h4><p>{module.why}</p><div class="guidance"><strong>{ui.coach}</strong><br />{module.guidance}</div></section>
              {module.caseStudy && (
                <section class="voice-case" aria-labelledby={`voice-case-${index}`}>
                  <div class="voice-case-head">
                    <h4 id={`voice-case-${index}`}>{module.caseStudy.label}</h4>
                    <p class="case-thesis">{module.caseStudy.title}</p>
                  </div>
                  <div class="voice-ways">
                    {module.caseStudy.ways.map((way) => (
                      <div class="voice-way"><strong>{way.title}</strong><p>{way.text}</p></div>
                    ))}
                  </div>
                  <div class="builder-note">
                    <p>{module.caseStudy.builderNote}</p>
                    <div class="case-links">
                      <a class="case-link" href={module.caseStudy.storyUrl}>{module.caseStudy.storyLabel} →</a>
                      <a class="case-link" href={module.caseStudy.productUrl} target="_blank" rel="noopener noreferrer">{module.caseStudy.productLabel} ↗</a>
                    </div>
                  </div>
                </section>
              )}
              {index === 7 && <div class="sello-scale" aria-label={`${ui.statusDraft}, ${ui.statusReviewed}, ${ui.statusFinished}`}>
                <div><strong>{ui.statusDraft}</strong><span>{es ? 'Existe una primera versión.' : 'A first version exists.'}</span></div>
                <div><strong>{ui.statusReviewed}</strong><span>{es ? 'Alguien la ha examinado.' : 'Someone has examined it.'}</span></div>
                <div><strong>{ui.statusFinished}</strong><span>{es ? 'Pruebas y permisos completos.' : 'Evidence and approvals complete.'}</span></div>
              </div>}
              <section class="block">
                <h4>{ui.practice}</h4>
                <div class="prompt"><div class="prompt-head"><span>{ui.route} {String(index + 1).padStart(2, '0')}</span><button class="copy" type="button" data-copy>{ui.copy}</button></div><pre>{module.prompt}</pre></div>
              </section>
              <div class="module-controls">
                <button class="nav-btn" type="button" data-prev disabled={index === 0}>{ui.previous}</button>
                <button class="nav-btn" type="button" data-next>{index === modules.length - 1 ? ui.finish : ui.next}</button>
              </div>
            </div>
            <aside class="side">
              <h4>{ui.proof}</h4>
              <p>{module.proof}</p>
              <h4>{ui.official}</h4>
              <div class="sources">{module.links.map((link) => <a class="source" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>
              <button class="complete" type="button" data-complete={index} aria-pressed="false">{ui.mark}</button>
            </aside>
          </article>
        ))}
      </section>

      <section class="closing">
        <h2>{ui.closeTitle}</h2>
        <p>{ui.closeText}</p>
        <button class="secondary" type="button" data-jump="0">{ui.restart}</button>
      </section>
    </main>
    <footer><span>{ui.footer}</span><span>recableado.blog · AI Costa</span></footer>
  </div>

  <script is:inline define:vars={{ lang, total: modules.length, copiedLabel: ui.copied, copyLabel: ui.copy, copyError: ui.copyError, showGuidance: ui.guidance, hideGuidance: ui.hideGuidance, markLabel: ui.mark, unmarkLabel: ui.unmark }}>
    (function(){
      var key='ai-costa-course-v1-'+lang;
      var state={active:0,done:[],guidance:false,theme:'dark'};
      try{var saved=JSON.parse(localStorage.getItem(key)||'{}');if(Number.isInteger(saved.active)&&saved.active>=0&&saved.active<total)state.active=saved.active;if(Array.isArray(saved.done))state.done=saved.done.filter(function(n){return Number.isInteger(n)&&n>=0&&n<total});if(typeof saved.guidance==='boolean')state.guidance=saved.guidance;if(saved.theme==='light'||saved.theme==='dark')state.theme=saved.theme}catch(e){}
      var tabs=[].slice.call(document.querySelectorAll('[data-module-tab]'));
      var panels=[].slice.call(document.querySelectorAll('[data-module]'));
      var completes=[].slice.call(document.querySelectorAll('[data-complete]'));
      var meter=document.querySelector('.meter');
      var meterBar=meter.querySelector('span');
      var progress=document.getElementById('progressCount');
      var guidance=document.getElementById('guidanceToggle');
      function save(){try{localStorage.setItem(key,JSON.stringify(state))}catch(e){}}
      function render(){
        document.documentElement.dataset.theme=state.theme;
        document.body.classList.toggle('show-guidance',state.guidance);
        guidance.setAttribute('aria-pressed',String(state.guidance));
        guidance.textContent=state.guidance?hideGuidance:showGuidance;
        tabs.forEach(function(tab,i){var active=i===state.active;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;tab.classList.toggle('is-done',state.done.indexOf(i)>-1)});
        panels.forEach(function(panel,i){var active=i===state.active;panel.hidden=!active;panel.classList.toggle('is-active',active)});
        completes.forEach(function(button,i){var done=state.done.indexOf(i)>-1;button.setAttribute('aria-pressed',String(done));button.textContent=done?unmarkLabel:markLabel});
        progress.textContent=state.done.length+' / '+total;
        meter.setAttribute('aria-valuenow',String(state.done.length));
        meterBar.style.transform='scaleX('+(state.done.length/total)+')';
      }
      function go(index,scroll){state.active=Math.max(0,Math.min(total-1,index));render();save();if(scroll)document.getElementById('course').scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});tabs[state.active].focus({preventScroll:true})}
      tabs.forEach(function(tab,i){tab.addEventListener('click',function(){go(i,false)});tab.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key==='ArrowDown'){e.preventDefault();go((i+1)%total,false)}if(e.key==='ArrowLeft'||e.key==='ArrowUp'){e.preventDefault();go((i-1+total)%total,false)}})});
      panels.forEach(function(panel,i){var prev=panel.querySelector('[data-prev]');var next=panel.querySelector('[data-next]');prev.addEventListener('click',function(){go(i-1,true)});next.addEventListener('click',function(){go(i===total-1?0:i+1,true)})});
      completes.forEach(function(button,i){button.addEventListener('click',function(){var at=state.done.indexOf(i);if(at>-1)state.done.splice(at,1);else state.done.push(i);state.done.sort();render();save()})});
      document.querySelectorAll('[data-jump]').forEach(function(button){button.addEventListener('click',function(){go(Number(button.dataset.jump),true)})});
      document.getElementById('continueButton').addEventListener('click',function(){go(state.active,true)});
      document.getElementById('themeToggle').addEventListener('click',function(){state.theme=state.theme==='dark'?'light':'dark';render();save()});
      guidance.addEventListener('click',function(){state.guidance=!state.guidance;render();save()});
      document.querySelectorAll('[data-copy]').forEach(function(button){button.addEventListener('click',function(){var text=button.closest('.prompt').querySelector('pre').textContent;var original=button.textContent;function ok(){button.textContent=copiedLabel;setTimeout(function(){button.textContent=original},1400)}function fallback(){var area=document.createElement('textarea');area.value=text;area.setAttribute('readonly','');area.style.position='fixed';area.style.opacity='0';document.body.appendChild(area);area.select();var worked=false;try{worked=document.execCommand('copy')}catch(e){}document.body.removeChild(area);if(worked)ok();else{button.textContent=copyError;setTimeout(function(){button.textContent=original},2200)}}if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(text).then(ok,fallback);else fallback()})});
      render();
    })();
  </script>
</body>
</html>
