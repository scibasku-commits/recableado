    .primary,.secondary{min-height:50px;padding:12px 18px;border-radius:14px;font:700 13px/1 var(--display);cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;border:1px solid var(--cyan)}
    .primary{background:var(--cyan);color:var(--navy)}
    .secondary{background:transparent;color:inherit}
    .route-map{border-top:1px solid var(--gold);padding-top:24px}
