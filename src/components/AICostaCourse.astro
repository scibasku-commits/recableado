    :root[data-theme='dark'] .guidance{background:var(--blue)}
    body.show-guidance .guidance{display:block}
    .voice-case{margin:34px 0 12px;border:1px solid var(--gold);border-radius:16px;overflow:hidden;background:var(--paper);color:var(--ink)}
    :root[data-theme='dark'] .voice-case{background:var(--blue);color:var(--white)}
