---
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const es = lang === 'es';
const canonical = `https://recableado.blog${es ? '/ai-costa/' : '/en/ai-costa/'}`;

const ui = es ? {
  title: 'AI Costa · IA útil, trabajo comprobado',
  description: 'Curso práctico y autónomo para empezar con IA, usar voz, documentos, creación y Codex, y terminar cada encargo con el Método SELLO.',
  brand: 'AI Costa · por Recableado', theme: 'Cambiar tema', hints: 'Mostrar pistas', hideHints: 'Ocultar pistas', language: 'English',
  hero: 'Haz trabajo real. Y sabe por qué está bien.',
  intro: 'Ocho módulos, tres recorridos y cero jerga. Empieza desde el principio o entra directamente en la tarea que hoy te está quitando tiempo.',
  progress: 'Tu avance en este dispositivo', completed: 'recorridos terminados', reset: 'Reiniciar avance', nav: 'Recorridos del curso',
  paths: [
    ['Recorrido 1', 'Hablar y encargar', 'Sales con un encargo que la IA puede ejecutar sin adivinar.'],
    ['Recorrido 2', 'Producir y comprobar', 'Conviertes información real en un resultado que puedes revisar.'],
    ['Recorrido 3', 'Construir y repetir', 'Pasas de una tarea aislada a un sistema bajo tu control.'],
  ],
  module: 'Módulo', try: 'Pruébalo ahora', proof: 'Termina cuando', copy: 'Copiar encargo', copied: 'Copiado', copyError: 'No se pudo copiar',
  hint: 'Pista si te atascas', finish: 'Marcar recorrido terminado', done: 'Recorrido terminado',
  statesTitle: 'Tres palabras que ya no significan lo mismo',
  states: [
    ['Borrador', 'Existe. Aún puede contener errores, huecos o frases sin fuente.'],
    ['Revisado', 'Se ha comparado con las fuentes y los criterios. Los fallos encontrados se han corregido.'],
    ['Terminado con evidencia', 'Funciona en el lugar real, las comprobaciones están registradas y no queda ninguna acción pendiente escondida.'],
  ],
  resources: 'Si quieres profundizar', resourcesIntro: 'Estas son las únicas lecturas externas del curso. Todas pertenecen a la documentación oficial de OpenAI y fueron comprobadas el 4 de septiembre de 2026.',
  faq: 'Antes de cerrar el portátil',
  faqs: [
    ['¿Tengo que aprender palabras técnicas?', 'No. Aprende a describir el resultado, a poner límites y a pedir pruebas. Los nombres de las herramientas vienen después.'],
    ['¿Puedo usar datos de clientes?', 'Para practicar, usa datos ficticios o anonimizados. Si un trabajo real contiene datos sensibles, comprueba primero las reglas de tu empresa y la configuración del servicio.'],
    ['¿Cuándo dejo que la IA actúe sola?', 'Cuando el trabajo es reversible, el alcance está claro y la prueba final es objetiva. Enviar, publicar, comprar, reservar o cambiar producción requiere tu luz verde antes de la acción.'],
  ],
  back: 'Volver a Recableado', footer: 'AI Costa · curso autónomo en español e inglés', skip: 'Saltar al curso',
} : {
  title: 'AI Costa · Useful AI, checked work',
  description: 'A practical, self-paced course to start with AI, use voice, documents, creation and Codex, and finish every assignment with the SELLO method.',
  brand: 'AI Costa · by Recableado', theme: 'Change theme', hints: 'Show hints', hideHints: 'Hide hints', language: 'Español',
  hero: 'Do real work. Know why it is right.',
  intro: 'Eight modules, three paths and no jargon. Start at the beginning or jump straight to the task that is taking your time today.',
  progress: 'Your progress on this device', completed: 'paths completed', reset: 'Reset progress', nav: 'Course paths',
  paths: [
    ['Path 1', 'Talk and assign', 'Leave with an assignment AI can execute without guessing.'],
    ['Path 2', 'Produce and check', 'Turn real information into an outcome you can review.'],
    ['Path 3', 'Build and repeat', 'Move from a one-off task to a system you control.'],
  ],
  module: 'Module', try: 'Try it now', proof: 'You are done when', copy: 'Copy assignment', copied: 'Copied', copyError: 'Could not copy',
  hint: 'Hint if you get stuck', finish: 'Mark path complete', done: 'Path complete',
  statesTitle: 'Three words that no longer mean the same thing',
  states: [
    ['Draft', 'It exists. It may still contain errors, gaps or statements without a source.'],
    ['Reviewed', 'It has been compared with the sources and criteria. The issues found have been corrected.'],
    ['Finished with evidence', 'It works in the real destination, the checks are recorded and no hidden action remains.'],
  ],
  resources: 'If you want to go deeper', resourcesIntro: 'These are the course’s only external readings. Every link belongs to official OpenAI documentation and was checked on 4 September 2026.',
  faq: 'Before you close the laptop',
  faqs: [
    ['Do I need to learn technical terms?', 'No. Learn to describe the outcome, set boundaries and ask for proof. Tool names come later.'],
    ['Can I use customer data?', 'Use fictional or anonymised data while practising. If real work contains sensitive data, first check your company rules and the service settings.'],
    ['When can I let AI act on its own?', 'When the work is reversible, the scope is clear and the final check is objective. Sending, publishing, buying, booking or changing production requires your green light before the action.'],
  ],
  back: 'Back to Recableado', footer: 'AI Costa · self-paced course in English and Spanish', skip: 'Skip to course',
};

const lessons = es ? [
  { id:1, path:1, title:'Empieza por una tarea, no por la herramienta', lead:'La primera decisión útil no es qué botón pulsar. Es elegir un trabajo pequeño, real y fácil de comprobar.', steps:['Elige algo que ya haces cada semana.','Reúne una fuente fiable: un texto, una tabla o una carpeta.','Pide una salida concreta que puedas leer en pocos minutos.'], proof:'puedes comparar el resultado con la fuente y señalar qué está bien o mal.', hint:'Una respuesta a una reseña, el resumen de una reunión o una lista de pendientes son mejores comienzos que «organiza mi empresa».', prompt:`Quiero empezar con IA usando una tarea pequeña de mi trabajo.

Hazme una sola pregunta cada vez para descubrir: qué tarea repito, qué información fiable tengo, qué resultado necesito y cómo podría comprobarlo.

Cuando tengas suficiente contexto, propón tres primeras pruebas de menos de 20 minutos. No ejecutes ninguna todavía.` },
  { id:2, path:1, title:'Usa la voz para vaciar la cabeza', lead:'Hablar captura contexto rápido. El paso importante viene después: convertir lo dicho en un encargo que puedas corregir antes de ejecutarlo.', steps:['Cuenta la situación como se la contarías a un compañero.','Pide que se separen hechos, dudas y decisiones.','Corrige la transcripción y aprueba solo la versión limpia.'], proof:'el resumen conserva tus hechos, marca las dudas y no convierte una suposición en una decisión.', hint:'Si hablas mientras piensas, avisa: «No respondas hasta que diga FIN». Luego revisa nombres, cifras y fechas.', prompt:`Voy a explicarte una situación por voz. No respondas hasta que diga FIN.

Después separa lo que has oído en cuatro bloques: hechos confirmados, dudas, decisiones pendientes y próximo resultado.

No completes nombres, cifras o fechas que yo no haya dicho. Señala con [REVISAR] cualquier parte ambigua y espera mi corrección antes de hacer el trabajo.` },
  { id:3, path:1, title:'Convierte una petición en un encargo', lead:'Una petición dice «haz algo». Un encargo define la verdad de partida, el resultado, el formato, los límites y la prueba final.', steps:['Fuente: de dónde puede sacar los hechos.','Resultado: qué cambio quieres conseguir.','Entrega: qué archivo, texto o tabla esperas.','Límites: qué no puede inventar ni ejecutar.','Prueba: qué debe comprobar antes de parar.'], proof:'otra persona puede leer el encargo y saber qué entregar, qué no tocar y cómo demostrar que acabó.', hint:'Si no puedes escribir la prueba final, el resultado aún es demasiado vago.', prompt:`Convierte mi petición en un encargo ejecutable.

Primero identifica cinco partes: fuente, resultado, entrega, límites y prueba final. Si falta alguna, pregúntame antes de continuar.

Devuélveme el encargo completo para aprobarlo. No empieces a ejecutarlo hasta que yo confirme que refleja lo que necesito.` },
  { id:4, path:1, title:'Método SELLO: no confundas hecho con terminado', lead:'SELLO es la pausa que separa un resultado vistoso de un trabajo fiable. Se usa antes de declarar que algo está acabado.', steps:['S · Salida definida: qué debe existir al final.','E · Ejecución acotada: qué puede hacer y con qué fuentes.','L · Leer las pruebas: comprobar contenido, función y límites.','L · Luz verde: pedir autorización antes de una acción real.','O · Observar el destino: verificar qué ocurrió de verdad.'], proof:'puedes enseñar el resultado, las pruebas, la autorización si hizo falta y la comprobación posterior.', hint:'Un correo redactado es borrador. Un correo revisado sigue sin estar enviado. Solo después de la autorización y la comprobación de envío puedes decir que salió.', prompt:`Pasa este trabajo por el Método SELLO.

1. Define la salida exacta.
2. Ejecuta solo dentro del alcance y de las fuentes aprobadas.
3. Haz las comprobaciones y muestra su resultado.
4. Si el siguiente paso envía, publica, compra, reserva o cambia algo real, detente y pide mi autorización.
5. Después de una acción autorizada, verifica el destino real.

Al final clasifica el estado como BORRADOR, REVISADO o TERMINADO CON EVIDENCIA y justifica la etiqueta con pruebas concretas.` },
  { id:5, path:2, title:'Documentos y oficina: trabaja sobre la fuente', lead:'La IA ayuda mejor cuando recibe el documento correcto y una pregunta que se puede contrastar. No hace falta pegar toda la oficina en un chat.', steps:['Selecciona solo los archivos necesarios.','Pide una tabla de hallazgos con referencia a su origen.','Separa extracción literal, cálculo e interpretación.','Revisa una muestra antes de ampliar el lote.'], proof:'cada cifra o afirmación importante conduce al documento del que salió.', hint:'Prueba primero con dos archivos. Si el formato y las referencias funcionan, añade el resto.', prompt:`Trabaja únicamente con los documentos que adjunto.

Necesito una tabla con: hallazgo, fuente exacta, dato literal y acción sugerida. Separa claramente lo que aparece en el documento de lo que tú deduces.

No inventes campos ni completes huecos. Si dos documentos se contradicen, muéstrame ambos valores y detente antes de elegir uno.` },
  { id:6, path:2, title:'Creación: primero el mensaje, después la forma', lead:'Una imagen, una presentación o una página no arreglan un mensaje confuso. Define qué debe entender la persona antes de pedir el formato.', steps:['Escribe la idea que debe quedar en una frase.','Aporta los hechos, la marca y los materiales permitidos.','Pide una primera versión y revisa texto y estructura.','Solo después produce el acabado final.'], proof:'el resultado comunica la idea aprobada, usa solo materiales permitidos y no añade afirmaciones decorativas.', hint:'Los testimonios, premios, precios y fotografías «de ambiente» también son datos: no dejes que aparezcan sin fuente o permiso.', prompt:`Quiero crear una pieza para explicar esta idea: [ESCRIBE LA IDEA].

Antes de producirla, resume el público, el mensaje principal, los hechos disponibles, los materiales permitidos y la acción esperada. Marca lo que falta.

Propón primero una estructura en texto. No generes ni publiques la pieza final hasta que yo apruebe esa estructura. No inventes cifras, testimonios, premios, precios ni imágenes de personas.` },
  { id:7, path:2, title:'Codex para trabajo real, aunque no programes', lead:'Codex puede leer un proyecto, cambiar archivos y ejecutar comprobaciones. Tu trabajo sigue siendo definir el resultado, proteger los límites y exigir evidencia.', steps:['Señala la carpeta o proyecto exacto.','Describe el cambio visible para la persona usuaria.','Nombra lo que debe permanecer intacto.','Pide pruebas concretas: build, enlaces y navegador.','Reserva el envío o publicación si no lo has autorizado.'], proof:'el cambio está en los archivos correctos, las pruebas terminan en verde y puedes ver el resultado en escritorio y móvil.', hint:'No elijas opciones técnicas si no cambian una decisión de negocio. Pide a Codex que decida y explique solo el efecto práctico.', prompt:`Trabaja en este proyecto: [RUTA O NOMBRE DEL PROYECTO].

Resultado visible: [QUÉ DEBE CAMBIAR].
Debe permanecer intacto: [QUÉ NO SE TOCA].

Lee primero las instrucciones del proyecto y comprueba si ya existe trabajo relacionado. Implementa el cambio, ejecuta las pruebas y revisa el resultado real en escritorio y móvil.

No envíes, publiques ni despliegues nada sin mi autorización expresa. Al terminar, informa de archivos cambiados, pruebas ejecutadas, resultado y cualquier limitación.` },
  { id:8, path:3, title:'Repite sin perder el control', lead:'Cuando una tarea funciona, puedes guardarla y conectarla. La clave no es automatizar más: es conservar fuentes, límites, paradas y pruebas.', steps:['Skill: una receta guardada para un trabajo concreto.','Hook: un control que se dispara en un momento previsto.','MCP: un puente autorizado hacia una herramienta o unos datos.','Automatización: una tarea que se ejecuta por horario o por un evento.'], proof:'un caso normal sale bien, una excepción activa la parada y una persona puede ver qué ocurrió.', hint:'Empieza por una skill sin conexiones. Añade un hook para comprobar. Conecta un MCP solo cuando necesites datos reales. Programa la automatización al final.', prompt:`Convierte el encargo aprobado en un procedimiento reutilizable.

Incluye: objetivo, fuentes, pasos, límites, prueba final y situaciones en las que debes detenerte. Después dime, sin jerga, si conviene dejarlo como instrucción, convertirlo en skill, añadir un hook, conectarlo por MCP o programarlo como automatización.

Propón primero la opción más sencilla. Incluye un caso normal y una excepción. No actives ninguna conexión ni programación sin mi autorización.` },
] : [
  { id:1, path:1, title:'Start with a task, not a tool', lead:'The first useful decision is not which button to press. Choose a small, real task that is easy to check.', steps:['Choose something you already do every week.','Gather one reliable source: a text, table or folder.','Ask for a concrete outcome you can review in a few minutes.'], proof:'you can compare the outcome with the source and point to what is right or wrong.', hint:'A reply to a review, a meeting summary or a task list is a better start than “organise my company”.', prompt:`I want to start using AI with one small task from my work.

Ask me one question at a time to discover: which task I repeat, what reliable information I have, which outcome I need and how I could check it.

When you have enough context, suggest three first trials that take less than 20 minutes. Do not run any of them yet.` },
  { id:2, path:1, title:'Use voice to empty your head', lead:'Speaking captures context quickly. The important step comes next: turn what you said into an assignment you can correct before execution.', steps:['Tell the story as you would to a colleague.','Ask for facts, doubts and decisions to be separated.','Correct the transcript and approve only the clean version.'], proof:'the summary keeps your facts, marks uncertainty and does not turn an assumption into a decision.', hint:'If you think aloud, say: “Do not reply until I say END”. Then review names, figures and dates.', prompt:`I am going to explain a situation by voice. Do not reply until I say END.

Then separate what you heard into four sections: confirmed facts, doubts, pending decisions and next outcome.

Do not complete names, figures or dates I did not say. Mark every ambiguous part with [REVIEW] and wait for my correction before doing the work.` },
  { id:3, path:1, title:'Turn a request into an assignment', lead:'A request says “do something”. An assignment defines the starting truth, outcome, format, boundaries and final check.', steps:['Source: where the facts may come from.','Outcome: which change you want.','Deliverable: which file, text or table you expect.','Boundaries: what it must not invent or execute.','Check: what must be verified before stopping.'], proof:'someone else can read the assignment and know what to deliver, what not to touch and how to prove completion.', hint:'If you cannot write the final check, the outcome is still too vague.', prompt:`Turn my request into an executable assignment.

First identify five parts: source, outcome, deliverable, boundaries and final check. If any part is missing, ask me before continuing.

Return the complete assignment for approval. Do not start executing until I confirm that it reflects what I need.` },
  { id:4, path:1, title:'The SELLO method: done is not the same as finished', lead:'SELLO is the pause between an impressive result and reliable work. Use it before declaring that anything is complete.', steps:['S · Specify the outcome: what must exist at the end.','E · Execute within bounds: what may be done and with which sources.','L · Look at the checks: verify content, function and boundaries.','L · Light turns green: obtain approval before a real action.','O · Observe the destination: verify what actually happened.'], proof:'you can show the outcome, checks, approval when required and the observation after the action.', hint:'A drafted email is a draft. A reviewed email is still not sent. Only after approval and delivery verification can you say it went out.', prompt:`Take this work through the SELLO method.

1. Specify the exact outcome.
2. Execute only within the approved scope and sources.
3. Run the checks and show their results.
4. If the next step sends, publishes, buys, books or changes something real, stop and request my approval.
5. After an approved action, verify the real destination.

At the end, label the state as DRAFT, REVIEWED or FINISHED WITH EVIDENCE and justify the label with concrete proof.` },
  { id:5, path:2, title:'Documents and office work: stay with the source', lead:'AI works best when it receives the right document and a question that can be checked. You do not need to paste the whole office into one chat.', steps:['Select only the necessary files.','Ask for a findings table with source references.','Separate literal extraction, calculation and interpretation.','Review a sample before expanding the batch.'], proof:'every important figure or statement leads back to the document it came from.', hint:'Start with two files. If the format and references work, add the rest.', prompt:`Work only with the documents I attach.

I need a table with: finding, exact source, literal data and suggested action. Clearly separate what appears in the document from what you infer.

Do not invent fields or fill gaps. If two documents conflict, show me both values and stop before choosing one.` },
  { id:6, path:2, title:'Creation: message first, format second', lead:'An image, presentation or web page cannot repair an unclear message. Define what someone should understand before asking for the format.', steps:['Write the idea that must remain in one sentence.','Provide facts, brand and permitted materials.','Ask for a first version and review copy and structure.','Only then produce the finished output.'], proof:'the outcome communicates the approved idea, uses only permitted materials and adds no decorative claims.', hint:'Testimonials, awards, prices and “atmospheric” photos are data too. Do not let them appear without a source or permission.', prompt:`I want to create a piece that explains this idea: [WRITE THE IDEA].

Before producing it, summarise the audience, main message, available facts, permitted materials and expected action. Mark what is missing.

First propose a text structure. Do not generate or publish the final piece until I approve that structure. Do not invent figures, testimonials, awards, prices or images of people.` },
  { id:7, path:2, title:'Codex for real work, even if you do not code', lead:'Codex can read a project, change files and run checks. Your job is still to define the outcome, protect boundaries and demand evidence.', steps:['Name the exact folder or project.','Describe the visible change for the user.','Name what must stay untouched.','Request concrete checks: build, links and browser review.','Keep sending or publishing under your control unless authorised.'], proof:'the change is in the right files, checks finish green and you can see the result on desktop and mobile.', hint:'Do not choose technical options that do not change a business decision. Ask Codex to decide and explain only the practical effect.', prompt:`Work in this project: [PROJECT PATH OR NAME].

Visible outcome: [WHAT MUST CHANGE].
Must remain untouched: [WHAT MUST NOT CHANGE].

First read the project instructions and check for related existing work. Implement the change, run the tests and review the real result on desktop and mobile.

Do not send, publish or deploy anything without my explicit approval. At the end, report changed files, checks run, results and any limitation.` },
  { id:8, path:3, title:'Repeat without losing control', lead:'When a task works, you can save and connect it. The point is not more automation: it is preserving sources, boundaries, stops and checks.', steps:['Skill: a saved recipe for one specific job.','Hook: a check that runs at a planned moment.','MCP: an authorised bridge to a tool or data.','Automation: a task that runs on a schedule or event.'], proof:'a normal case works, an exception triggers the stop and a person can see what happened.', hint:'Start with a skill and no connection. Add a hook for checking. Connect MCP only when real data is needed. Schedule the automation last.', prompt:`Turn the approved assignment into a reusable procedure.

Include: objective, sources, steps, boundaries, final check and situations where you must stop. Then explain, without jargon, whether it should remain an instruction, become a skill, gain a hook, connect through MCP or run as an automation.

Suggest the simplest option first. Include one normal case and one exception. Do not activate any connection or schedule without my approval.` },
];

const resources = es ? [
  ['Cómo escribir mejores encargos','Guía oficial de prompting','https://learn.chatgpt.com/docs/prompting'],
  ['Trabajar con la voz','Voz en ChatGPT','https://learn.chatgpt.com/docs/features/voice'],
  ['Guardar un procedimiento','Skills en ChatGPT y Codex','https://learn.chatgpt.com/docs/build-skills'],
  ['Conectar herramientas y datos','Model Context Protocol','https://learn.chatgpt.com/docs/extend/mcp?surface=cli'],
  ['Ejecutar controles automáticos','Hooks de Codex','https://learn.chatgpt.com/docs/hooks'],
  ['Programar trabajo recurrente','Tareas programadas','https://learn.chatgpt.com/docs/automations'],
] : [
  ['Write better assignments','Official prompting guide','https://learn.chatgpt.com/docs/prompting'],
  ['Work with voice','Voice in ChatGPT','https://learn.chatgpt.com/docs/features/voice'],
  ['Save a procedure','Skills in ChatGPT and Codex','https://learn.chatgpt.com/docs/build-skills'],
  ['Connect tools and data','Model Context Protocol','https://learn.chatgpt.com/docs/extend/mcp?surface=cli'],
  ['Run automatic checks','Codex hooks','https://learn.chatgpt.com/docs/hooks'],
  ['Schedule recurring work','Scheduled tasks','https://learn.chatgpt.com/docs/automations'],
];
---
<!doctype html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="color-scheme" content="light dark"><meta name="theme-color" content="#0a1628"><meta name="robots" content="index,follow">
  <title>{ui.title}</title><meta name="description" content={ui.description}><link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="es" href="https://recableado.blog/ai-costa/"><link rel="alternate" hreflang="en" href="https://recableado.blog/en/ai-costa/"><link rel="alternate" hreflang="x-default" href="https://recableado.blog/ai-costa/"><link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta property="og:type" content="website"><meta property="og:url" content={canonical}><meta property="og:title" content={ui.title}><meta property="og:description" content={ui.description}><meta property="og:image" content="https://recableado.blog/ai-costa-social.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content={ui.title}>
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={ui.title}><meta name="twitter:description" content={ui.description}><meta name="twitter:image" content="https://recableado.blog/ai-costa-social.png">
  <script async src="https://umami-scibasku.vercel.app/script.js" data-website-id="9b2bc6f2-f7a4-4099-8296-42091c2ba4bf"></script>
</head>
<body>
<a class="skip" href="#course">{ui.skip}</a>
<div class="wrap path-1 hints-off" id="root" data-lang={lang}>
  <header class="topbar"><a class="brand" href={es ? '/' : '/en/'}>{ui.brand}</a><div class="controls"><button class="control" id="themeToggle" type="button" aria-pressed="false">{ui.theme}</button><button class="control" id="hintsToggle" type="button" aria-pressed="false" data-off={ui.hints} data-on={ui.hideHints}>{ui.hints}</button><a class="control" href={es ? '/en/ai-costa/' : '/ai-costa/'} hreflang={es ? 'en' : 'es'}>{ui.language}</a></div></header>
  <main id="course">
    <section class="hero"><div><h1>{ui.hero}</h1><p>{ui.intro}</p></div><div class="hero-mark" aria-hidden="true"><span>S</span><span>E</span><span>L</span><span>L</span><span>O</span></div></section>
    <section class="progress"><div><h2>{ui.progress}</h2><p><strong id="progressCount">0 / 3</strong> {ui.completed}</p></div><progress id="progressBar" max="3" value="0">0 / 3</progress><button class="text-button" id="resetProgress" type="button">{ui.reset}</button></section>
    <nav class="path-nav" aria-label={ui.nav}>{ui.paths.map((path,i)=><button type="button" data-go={String(i+1)} aria-pressed={i===0?'true':'false'}><span>{path[0]}</span><strong>{path[1]}</strong><small>{path[2]}</small></button>)}</nav>
    {[1,2,3].map(path=><div class="path" data-path={String(path)}>{lessons.filter(x=>x.path===path).map(lesson=><article class:list={['lesson',{'sello':lesson.id===4}]} id={`module-${lesson.id}`}><div class="index"><span>{ui.module}</span><strong>{String(lesson.id).padStart(2,'0')}</strong></div><div class="lesson-body"><h2>{lesson.title}</h2><p class="lead">{lesson.lead}</p><ol class="steps">{lesson.steps.map(step=><li>{step}</li>)}</ol>{lesson.id===4&&<section class="states"><h3>{ui.statesTitle}</h3><div>{ui.states.map(state=><article><strong>{state[0]}</strong><p>{state[1]}</p></article>)}</div></section>}<div class="prompt"><div><span>{ui.try} · {ui.module} {lesson.id}</span><button class="copy" type="button" data-copied={ui.copied} data-error={ui.copyError}>{ui.copy}</button></div><pre>{lesson.prompt}</pre></div><div class="evidence"><strong>{ui.proof}</strong><span>{lesson.proof}</span></div><aside class="hint"><strong>{ui.hint}</strong><p>{lesson.hint}</p></aside></div></article>)}<button class="path-complete" type="button" data-complete={String(path)} data-off={ui.finish} data-on={ui.done}>{ui.finish}</button></div>)}
