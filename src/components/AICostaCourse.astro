  <style is:inline>
    @font-face{font-family:Bricolage;src:url('/fonts/BricolageGrotesque-Regular.ttf') format('truetype');font-weight:400;font-display:swap}
    @font-face{font-family:Bricolage;src:url('/fonts/BricolageGrotesque-Bold.ttf') format('truetype');font-weight:700 900;font-display:swap}
    :root{--navy:#0a1628;--blue:#0d2847;--gold:#d4af37;--cyan:#1fb4d1;--white:#fff;--muted:#b8c5d6;--ink:#2d3748;--paper:#f8f9fa;--line:#e2e8f0;--display:Bricolage,Arial,sans-serif;--body:Charter,'Iowan Old Style',Georgia,serif;--mono:ui-monospace,SFMono-Regular,Menlo,monospace;color-scheme:dark}
    :root[data-theme='light']{color-scheme:light}
    *{box-sizing:border-box}
    html{overflow-x:hidden;scroll-behavior:smooth;background:var(--navy)}
    body{margin:0;min-width:320px;overflow-x:hidden;background:linear-gradient(135deg,var(--navy),var(--blue));color:var(--white);font-family:var(--body);font-size:18px;line-height:1.65;-webkit-font-smoothing:antialiased}
    :root[data-theme='light'] body{background:var(--paper);color:var(--ink)}
	    ::selection{background:var(--cyan);color:var(--navy)}
	    :focus-visible{outline:3px solid var(--cyan);outline-offset:3px}
	    :root[data-theme='light'] :focus-visible{outline-color:var(--blue)}
    a{color:inherit;text-underline-offset:.24em}
    button{font:inherit}
    .shell{width:min(1180px,100%);margin:auto;padding:20px clamp(18px,4vw,48px) 80px}
    .top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:4px 0 20px;border-bottom:1px solid rgba(212,175,55,.6)}
    .brand{min-height:44px;display:inline-flex;align-items:center;font:700 12px/1.2 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
    :root[data-theme='light'] .brand,:root[data-theme='light'] .gift,:root[data-theme='light'] .module-tab span{color:var(--blue)}
    .controls{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}
    .control,.lang{min-width:44px;min-height:44px;border:1px solid var(--gold);background:transparent;color:inherit;padding:9px 13px;border-radius:12px;cursor:pointer;font:700 11px/1 var(--mono);letter-spacing:.05em;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
