const modules: CourseModule[] = es ? [
  {
    title: 'Empieza con una conversación real',
    short: 'Empezar',
    aim: 'Abrir ChatGPT y convertir una situación de tu trabajo en una conversación útil, sin aprender una fórmula.',
    why: 'La mejor primera prueba no es preguntar qué puede hacer la IA. Es traerle algo que ya ocupa espacio en tu cabeza: una decisión, un correo difícil o una idea a medio formar.',
    guidance: 'Habla como hablarías con una persona nueva en tu equipo. Si la respuesta no te sirve, no empieces de cero: señala qué falta y continúa.',
    prompt: `Estoy trabajando en [describe la situación real en dos frases].\n\nAntes de proponer nada, hazme tres preguntas, de una en una, para entender qué resultado necesito y qué límites no debemos cruzar.\n\nCuando tengas mis respuestas, resume el problema en lenguaje sencillo y propón un primer paso pequeño que pueda revisar hoy.`,
    proof: 'Puedes explicar en una frase qué decisión o siguiente paso salió de la conversación.',
    links: [{ label: 'Cómo empezar con ChatGPT', href: 'https://learn.chatgpt.com/docs/quickstart' }],
  },
  {
    title: 'Piensa y trabaja por voz',
    short: 'Voz',
    aim: 'Usar la voz para desarrollar una idea, dar contexto y corregir el rumbo sin tener que redactarlo todo.',
    why: 'Hablar libera detalle que muchas veces desaparece al escribir deprisa. La voz funciona especialmente bien para ordenar una situación, ensayar un mensaje o comentar un trabajo mientras lo miras.',
    guidance: 'Usa conversación por voz si quieres ida y vuelta; usa dictado si prefieres revisar el texto antes de enviarlo. La disponibilidad puede variar según cuenta y espacio de trabajo.',
    prompt: `Quiero pensar en voz alta contigo sobre [tema].\n\nEscucha primero. No me des una solución hasta que diga «ya está». Entonces devuélveme:\n1. lo que parece decidido;\n2. lo que sigue abierto;\n3. la pregunta que más conviene responder ahora.\n\nSi me contradigo, señálalo con calma y cita las dos ideas en conflicto.`,
    proof: 'Al terminar tienes un resumen con decisiones, dudas abiertas y un siguiente paso.',
    links: [{ label: 'Voz en ChatGPT', href: 'https://learn.chatgpt.com/docs/features/voice' }],
    caseStudy: {
      label: 'Dos formas de trabajar por voz',
      title: 'Conversar con ChatGPT. Dictar con Háblame.',
      ways: [
        {
          title: 'ChatGPT por voz',
          text: 'Mantienes una conversación con la IA: piensas en voz alta, recibes preguntas y corriges el rumbo. La conversación utiliza el servicio de ChatGPT.',
        },
        {
          title: 'Háblame, en local',
          text: 'Mantienes una tecla pulsada, hablas y el texto aparece donde tengas el cursor. El audio del dictado se procesa en tu PC o Mac. Si después envías ese texto a ChatGPT, el texto sí sale del equipo.',
        },
      ],
      builderNote: 'Yo construí Háblame con ayuda de la IA sin escribir el código desde cero. Partí de Handy, un proyecto abierto con licencia MIT. Yo decidí el nombre, la privacidad, el funcionamiento y las pruebas; la IA ayudó a planificar, transformar y revisar. La lección no es «la IA hace aplicaciones»: hablar, decidir y comprobar también es construir.',
      storyLabel: 'Leer cómo construí Háblame',
      storyUrl: '/blog/033-hablame-mi-app-de-dictado/',
      productLabel: 'Ver Háblame',
      productUrl: 'https://hablame.blog/',
    },
  },
  {
    title: 'Encarga trabajo, no pidas magia',
    short: 'Encargar',
    aim: 'Dar a la IA un resultado, fuentes, límites y una definición clara de “hecho”.',
    why: '“Hazme algo bonito” obliga a adivinar. Un buen encargo deja claro qué verdad puede usar, qué debe entregar, qué está prohibido y cómo se comprobará.',
    guidance: 'No necesitas escribir un tratado. Para un trabajo importante, incluye contexto, objetivo, entregable, límites y comprobación.',
    prompt: `Contexto: [qué está pasando y para quién].\nFuente de verdad: usa solo [documento, notas o datos que adjunto].\nResultado: necesito [resultado concreto].\nEntregable: dame [formato que puedas revisar].\nLímites: no inventes datos y no envíes, publiques, compres ni cambies nada sin mi autorización.\nComprobación: termina con una lista que demuestre qué has verificado y qué queda pendiente.`,
    proof: 'Otra persona puede leer el encargo y saber qué entregar, qué no hacer y cómo comprobarlo.',
    links: [{ label: 'Guía oficial de prompting', href: 'https://learn.chatgpt.com/docs/prompting' }],
  },
  {
    title: 'Trabaja con documentos y oficina',
    short: 'Oficina',
    aim: 'Convertir archivos reales en un documento, una hoja, una presentación o un PDF que puedas revisar.',
    why: 'La IA aporta más cuando parte de tu material y termina en un objeto útil. El archivo final importa tanto como la respuesta en el chat.',
    guidance: 'Adjunta solo material que puedas compartir. Indica tipo de archivo, estructura y criterios de revisión. Comprueba nombres, cifras, fórmulas y páginas antes de usar el resultado.',
    prompt: `Usa únicamente el archivo que adjunto.\n\nCrea un resumen ejecutivo de una página para una persona que no conoce el tema. Incluye: situación, tres hallazgos, decisiones necesarias y próximos pasos.\n\nConserva nombres y cifras exactamente como aparecen. Si dos datos no cuadran, no elijas uno: crea una sección «Por comprobar» con ambos y su ubicación.\n\nEntrégalo en un formato editable y revisa que no haya texto cortado ni páginas vacías.`,
    proof: 'El archivo abre, se puede editar y cada cifra importante se rastrea hasta el material original.',
    links: [{ label: 'Trabajar con archivos', href: 'https://learn.chatgpt.com/docs/artifacts-viewer' }],
  },
  {
    title: 'Crea algo que se pueda ver',
    short: 'Crear',
    aim: 'Pasar de una idea a una imagen o pieza visual y mejorarla mediante instrucciones concretas.',
    why: 'La primera versión sirve para descubrir lo que en realidad querías. Describe propósito, público, composición y restricciones; después corrige una cosa cada vez.',
    guidance: 'No inventes logotipos, premios, testimonios ni rostros de clientes. Si una imagen representa un producto real, compara los detalles antes de publicarla.',
    prompt: `Crea una imagen horizontal para explicar [idea] a [público].\n\nDebe mostrar [elemento principal] en [entorno], con una composición clara y espacio limpio para un título breve. El tono es [tres adjetivos concretos].\n\nNo incluyas logotipos, texto pequeño, marcas, premios ni personas reconocibles.\n\nAntes de generar, resume en una frase la composición que vas a crear.`,
    proof: 'La imagen comunica la idea sin explicación adicional y no contiene texto, marcas o detalles inventados.',
    links: [{ label: 'Generación de imágenes', href: 'https://learn.chatgpt.com/docs/image-generation' }],
  },
  {
    title: 'Usa Codex para trabajo real',
    short: 'Codex',
    aim: 'Dar a Codex una carpeta o proyecto, pedir un resultado concreto y exigir que pruebe lo que ha hecho.',
    why: 'Codex no es solo para programadores. Puede investigar un proyecto, ordenar información y construir entregables, siempre dentro de los permisos que le des.',
    guidance: 'Empieza con un trabajo reversible. Dile qué puede leer, qué puede cambiar y qué acción real necesita tu permiso. Nunca pegues contraseñas ni secretos en el chat o en los archivos.',
    prompt: `Trabaja en este proyecto para conseguir [resultado].\n\nPrimero localiza las normas y los archivos que ya existen. Dime qué vas a usar como fuente de verdad.\n\nPuedes leer y preparar cambios dentro del proyecto. No puedes enviar, borrar, comprar, desplegar ni publicar sin preguntarme.\n\nAl terminar, ejecuta las comprobaciones adecuadas y entrégame: archivos cambiados, resultado de las pruebas y cualquier limitación real.`,
    proof: 'Puedes abrir el resultado, ver los archivos cambiados y leer la salida de una comprobación ejecutada.',
    links: [{ label: 'Elegir entre Chat, Work y Codex', href: 'https://learn.chatgpt.com/docs/use-chatgpt' }],
  },
  {
    title: 'Haz que lo bueno se pueda repetir',
    short: 'Repetir',
    aim: 'Entender skills, hooks, MCP y automatizaciones como cuatro formas sencillas de repetir, vigilar o conectar trabajo.',
    why: 'Una skill guarda una forma de trabajar; un hook comprueba algo en un momento concreto; MCP conecta herramientas y contexto; una automatización vuelve a ejecutar un encargo cuando toca.',
    guidance: 'No empieces por la tecnología. Elige primero una tarea que ya hayas hecho bien dos veces. Guárdala, pruébala con un caso normal y con una excepción, y solo después piensa en automatizarla.',
    prompt: `Convierte el trabajo que acabamos de aprobar en un procedimiento reutilizable.\n\nGuarda: objetivo, fuentes, pasos, límites, prueba final y situaciones en las que debes parar y preguntarme.\n\nAñade dos casos de prueba: uno normal y uno con un dato esencial ausente.\n\nDespués dime, sin jerga, si esto conviene guardarlo como una instrucción, ejecutarlo en un horario, conectarlo a otra herramienta o añadirle una comprobación automática. No configures nada todavía.`,
    proof: 'El procedimiento resuelve el caso normal y se detiene correctamente cuando falta un dato esencial.',
    links: [
      { label: 'Skills', href: 'https://learn.chatgpt.com/docs/build-skills' },
      { label: 'MCP', href: 'https://learn.chatgpt.com/docs/extend/mcp' },
      { label: 'Hooks', href: 'https://learn.chatgpt.com/docs/hooks' },
      { label: 'Tareas programadas', href: 'https://learn.chatgpt.com/docs/automations' },
    ],
  },
  {
    title: 'Método SELLO: termina con evidencia',
    short: 'SELLO',
    aim: 'Separar lo que parece correcto de lo que está comprobado y reservar las acciones reales para una autorización explícita.',
    why: 'El Método SELLO de Giora convierte el final del trabajo en una serie de puertas: definir el resultado, hacer, comprobar, pedir permiso antes de una acción real y verificar después el resultado público.',
    guidance: 'Un borrador existe. Un trabajo revisado ha recibido una mirada crítica. Solo está terminado cuando cumple los criterios y la evidencia está delante de ti.',
    prompt: `Aplica el Método SELLO a este trabajo: [describe el trabajo].\n\n1. Define conmigo el resultado y las pruebas antes de actuar.\n2. Haz solo el trabajo reversible autorizado.\n3. Comprueba el resultado con evidencia visible.\n4. Si el siguiente paso envía, publica, compra, reserva o cambia algo real, detente y pide mi autorización explícita.\n5. Después de esa acción, vuelve a verificar el resultado real.\n\nAl final etiqueta el estado como BORRADOR, REVISADO o TERMINADO. No uses TERMINADO si falta una prueba o una autorización.`,
    proof: 'Hay una evidencia para cada criterio, la autorización precede a cualquier acción real y el resultado final se ha vuelto a comprobar.',
    links: [{ label: 'Permisos y control en Codex', href: 'https://learn.chatgpt.com/docs/permissions' }],
  },
] : [
  {
    title: 'Start with a real conversation', short: 'Start',
    aim: 'Open ChatGPT and turn a real work situation into a useful conversation without learning a formula.',
    why: 'The best first experiment is not asking what AI can do. Bring something that already occupies your mind: a decision, a difficult email, or a half-formed idea.',
    guidance: 'Speak as you would to a new person on your team. If the answer is not useful, do not start over: point out what is missing and continue.',
    prompt: `I am working on [describe the real situation in two sentences].\n\nBefore suggesting anything, ask me three questions, one at a time, to understand the outcome I need and the boundaries we must not cross.\n\nWhen you have my answers, summarise the problem in plain language and suggest one small first step I can review today.`,
    proof: 'You can explain in one sentence which decision or next step came out of the conversation.',
    links: [{ label: 'Getting started with ChatGPT', href: 'https://learn.chatgpt.com/docs/quickstart' }],
  },
  {
    title: 'Think and work by voice', short: 'Voice',
    aim: 'Use voice to develop an idea, add context and correct course without having to write everything.',
    why: 'Speaking releases detail that often disappears when we type in a hurry. Voice is especially useful for sorting out a situation, rehearsing a message, or discussing work while looking at it.',
    guidance: 'Use voice chat for a live exchange; use dictation when you want to review the text before sending it. Availability can vary by account and workspace.',
    prompt: `I want to think out loud with you about [topic].\n\nListen first. Do not give me a solution until I say “that is all”. Then return:\n1. what seems decided;\n2. what remains open;\n3. the most useful question to answer next.\n\nIf I contradict myself, point it out calmly and quote the two conflicting ideas.`,
    proof: 'You finish with a summary of decisions, open questions and one next step.',
    links: [{ label: 'Voice in ChatGPT', href: 'https://learn.chatgpt.com/docs/features/voice' }],
    caseStudy: {
      label: 'Two ways to work by voice',
      title: 'Talk with ChatGPT. Dictate with Háblame.',
      ways: [
        {
          title: 'ChatGPT voice',
          text: 'You have a conversation with AI: think out loud, receive questions and correct course. The conversation uses the ChatGPT service.',
        },
        {
          title: 'Háblame, on your computer',
          text: 'Hold a key, speak and the text appears wherever your cursor is. Dictation audio is processed on your PC or Mac. If you later send that text to ChatGPT, the text does leave your computer.',
        },
      ],
      builderNote: 'I built Háblame with AI assistance without writing the code from scratch. I started from Handy, an open-source project under the MIT licence. I decided the name, privacy, behaviour and tests; AI helped plan, transform and review. The lesson is not “AI makes apps”: speaking, deciding and checking are also ways of building.',
      storyLabel: 'Read how I built Háblame',
      storyUrl: '/en/blog/033-i-built-my-own-dictation-app/',
      productLabel: 'See Háblame',
      productUrl: 'https://hablame.blog/en/',
    },
  },
  {
    title: 'Assign work instead of asking for magic', short: 'Assign',
    aim: 'Give AI an outcome, sources, boundaries and a clear definition of “done”.',
    why: '“Make something beautiful” forces the system to guess. A strong assignment says which truth it may use, what it must deliver, what is forbidden and how the work will be checked.',
    guidance: 'You do not need a long document. For important work, include context, objective, deliverable, boundaries and verification.',
    prompt: `Context: [what is happening and who it is for].\nSource of truth: use only [the document, notes or data I attach].\nOutcome: I need [specific result].\nDeliverable: give me [a format I can review].\nBoundaries: do not invent facts, and do not send, publish, buy or change anything without my approval.\nVerification: finish with a list showing what you checked and what remains open.`,
    proof: 'Another person can read the assignment and know what to deliver, what not to do and how to check it.',
    links: [{ label: 'Official prompting guide', href: 'https://learn.chatgpt.com/docs/prompting' }],
  },
  {
    title: 'Work with documents and office files', short: 'Office',
    aim: 'Turn real files into a document, spreadsheet, presentation or PDF that you can review.',
    why: 'AI contributes more when it starts with your material and ends with a useful object. The final file matters as much as the answer in the chat.',
    guidance: 'Only attach material you are allowed to share. State the file type, structure and review criteria. Check names, figures, formulas and pages before using the result.',
    prompt: `Use only the file I attach.\n\nCreate a one-page executive summary for someone new to the topic. Include: situation, three findings, decisions needed and next steps.\n\nKeep names and figures exactly as written. If two facts conflict, do not choose one: create a “To verify” section with both and their locations.\n\nReturn it in an editable format and check for cropped text or blank pages.`,
    proof: 'The file opens, can be edited and every important figure can be traced to the original material.',
    links: [{ label: 'Work with files', href: 'https://learn.chatgpt.com/docs/artifacts-viewer' }],
  },
  {
    title: 'Create something people can see', short: 'Create',
    aim: 'Move from an idea to an image or visual piece and improve it through concrete instructions.',
    why: 'The first version helps you discover what you actually wanted. Describe purpose, audience, composition and restrictions; then correct one thing at a time.',
    guidance: 'Do not invent logos, awards, testimonials or customer faces. If an image represents a real product, compare the details before publishing it.',
    prompt: `Create a horizontal image that explains [idea] to [audience].\n\nShow [main element] in [setting], with a clear composition and clean space for a short title. The mood is [three concrete adjectives].\n\nDo not include logos, small text, brands, awards or recognisable people.\n\nBefore generating, summarise the composition you will create in one sentence.`,
    proof: 'The image communicates the idea without extra explanation and contains no invented text, brands or details.',
    links: [{ label: 'Image generation', href: 'https://learn.chatgpt.com/docs/image-generation' }],
  },
  {
    title: 'Use Codex for real work', short: 'Codex',
    aim: 'Give Codex a folder or project, request a concrete outcome and require proof of what it did.',
    why: 'Codex is not only for programmers. It can investigate a project, organise information and build deliverables within the permissions you give it.',
    guidance: 'Start with reversible work. Say what it may read, what it may change and which real action needs your approval. Never paste passwords or secrets into a chat or file.',
    prompt: `Work in this project to achieve [outcome].\n\nFirst find the existing rules and files. Tell me what you will use as the source of truth.\n\nYou may read and prepare changes inside the project. You may not send, delete, buy, deploy or publish without asking me.\n\nWhen finished, run the appropriate checks and return: changed files, test results and any real limitation.`,
    proof: 'You can open the result, see the changed files and read the output of an executed check.',
    links: [{ label: 'Choose between Chat, Work and Codex', href: 'https://learn.chatgpt.com/docs/use-chatgpt' }],
  },
  {
    title: 'Make good work repeatable', short: 'Repeat',
    aim: 'Understand skills, hooks, MCP and automations as four simple ways to repeat, watch or connect work.',
    why: 'A skill stores a way of working; a hook checks something at a specific moment; MCP connects tools and context; an automation runs an assignment again when the time comes.',
    guidance: 'Do not start with the technology. Choose a task you have already done well twice. Save it, test a normal case and an exception, and only then consider automating it.',
    prompt: `Turn the work we just approved into a reusable procedure.\n\nKeep its objective, sources, steps, boundaries, final test and situations where you must stop and ask me.\n\nAdd two test cases: one normal and one with an essential fact missing.\n\nThen tell me, without jargon, whether this should be saved as an instruction, run on a schedule, connected to another tool or given an automatic check. Do not configure anything yet.`,
    proof: 'The procedure handles the normal case and stops correctly when an essential fact is missing.',
    links: [
      { label: 'Skills', href: 'https://learn.chatgpt.com/docs/build-skills' },
      { label: 'MCP', href: 'https://learn.chatgpt.com/docs/extend/mcp' },
      { label: 'Hooks', href: 'https://learn.chatgpt.com/docs/hooks' },
      { label: 'Scheduled tasks', href: 'https://learn.chatgpt.com/docs/automations' },
    ],
  },
  {
    title: 'The SELLO Method: finish with evidence', short: 'SELLO',
    aim: 'Separate what looks right from what has been checked, and reserve real-world actions for explicit approval.',
    why: 'Giora’s SELLO Method turns the end of a job into a series of gates: define the outcome, do the work, check it, ask permission before a real action, and then verify the public result.',
    guidance: 'A draft exists. Reviewed work has received a critical look. It is only finished when every criterion is met and the evidence is in front of you.',
    prompt: `Apply the SELLO Method to this job: [describe the job].\n\n1. Define the outcome and checks with me before acting.\n2. Do only the reversible work that is authorised.\n3. Check the result with visible evidence.\n4. If the next step sends, publishes, buys, books or changes something real, stop and ask for my explicit approval.\n5. After that action, verify the real result again.\n\nFinally label the status DRAFT, REVIEWED or FINISHED. Do not use FINISHED if evidence or approval is missing.`,
    proof: 'There is evidence for every criterion, approval precedes any real action and the final result has been checked again.',
    links: [{ label: 'Permissions and control in Codex', href: 'https://learn.chatgpt.com/docs/permissions' }],
