---
// Franja «Vídeos» de la portada, con aspecto de YouTube.
// Cada vídeo se reproduce en la propia página: si tiene `youtubeId` carga el
// reproductor de YouTube; si no (borrador), usa el fichero local `src`.
interface Video {
	title: string;
	duration: string;
	poster: string;
	youtubeId?: string;
	src?: string;
	href?: string;
}
interface Props {
	heading: string;
	shortsLabel: string;
	main: Video;
	shorts: Video[];
}
const { heading, shortsLabel, main, shorts } = Astro.props;
---

<section class="video-shelf">
	<h2 class="section-title">{heading}</h2>
	<div class="vs-layout">
		<div class="vs-main">
			<button type="button" class="vs-player vs-wide" data-yt={main.youtubeId} data-src={main.src} aria-label={`Reproducir: ${main.title}`}>
				<img src={main.poster} alt="" loading="lazy" />
				<span class="vs-play" aria-hidden="true"></span>
				<span class="vs-time">{main.duration}</span>
			</button>
			<h3 class="vs-title">{main.href ? <a href={main.href}>{main.title}</a> : main.title}</h3>
		</div>
		<div class="vs-shorts">
			<p class="vs-shorts-label">{shortsLabel}</p>
			<div class="vs-shorts-row">
				{shorts.map((v) => (
					<div class="vs-short">
						<button type="button" class="vs-player vs-tall" data-yt={v.youtubeId} data-src={v.src} aria-label={`Reproducir: ${v.title}`}>
							<img src={v.poster} alt="" loading="lazy" />
							<span class="vs-play" aria-hidden="true"></span>
							<span class="vs-time">{v.duration}</span>
						</button>
						<p class="vs-short-title">{v.title}</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script is:inline>
	document.querySelectorAll('.vs-player').forEach((btn) => {
		btn.addEventListener('click', () => {
			const yt = btn.dataset.yt;
			const src = btn.dataset.src;
			let el;
			if (yt) {
				el = document.createElement('iframe');
				el.src = `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0`;
				el.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
				el.allowFullscreen = true;
				el.title = btn.getAttribute('aria-label') || '';
			} else if (src) {
				el = document.createElement('video');
				el.src = src;
				el.controls = true;
				el.autoplay = true;
				el.playsInline = true;
			} else {
				return;
			}
			const box = document.createElement('div');
			box.className = btn.className.replace('vs-player', 'vs-frame');
			box.appendChild(el);
			btn.replaceWith(box);
		});
	});
</script>

<style>
	.video-shelf { margin-bottom: 3em; }
	.vs-layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 1.5em; align-items: start; }
	.vs-player, .vs-frame {
		position: relative; display: block; width: 100%; padding: 0; border: 0;
		border-radius: 12px; overflow: hidden; background: #0a1628; cursor: pointer;
	}
	.vs-wide { aspect-ratio: 16 / 9; }
	.vs-tall { aspect-ratio: 9 / 16; }
	.vs-player img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
	.vs-player:hover img { transform: scale(1.03); }
	.vs-player:focus-visible { outline: 3px solid var(--naranja); outline-offset: 3px; }
	.vs-frame { cursor: default; }
	.vs-frame :global(iframe), .vs-frame :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; }
	.vs-play {
		position: absolute; top: 50%; left: 50%; width: 68px; height: 48px;
		transform: translate(-50%, -50%); border-radius: 14px; background: #e8825c;
		box-shadow: 0 4px 14px rgba(0,0,0,0.35); transition: transform 0.2s ease;
	}
	.vs-play::after {
		content: ''; position: absolute; top: 50%; left: 50%;
		transform: translate(-40%, -50%);
		border-style: solid; border-width: 10px 0 10px 18px;
		border-color: transparent transparent transparent white;
	}
	.vs-player:hover .vs-play { transform: translate(-50%, -50%) scale(1.08); }
	.vs-tall .vs-play { width: 48px; height: 34px; border-radius: 10px; }
	.vs-tall .vs-play::after { border-width: 7px 0 7px 12px; }
	.vs-time {
		position: absolute; right: 8px; bottom: 8px; padding: 2px 6px; border-radius: 4px;
		background: rgba(0,0,0,0.8); color: white; font: 700 0.75em/1.4 'Space Mono', monospace;
	}
	.vs-title {
		font-family: 'Bricolage Grotesque', sans-serif; color: var(--heading);
		font-size: 1.25em; line-height: 1.3; margin: 0.7em 0 0;
	}
	.vs-title a { color: inherit; text-decoration: none; }
	.vs-title a:hover { color: var(--link); }
	.vs-shorts-label {
		font: 700 0.8em/1 'Space Mono', monospace; letter-spacing: 0.08em; text-transform: uppercase;
		color: var(--naranja); margin: 0 0 0.8em;
	}
	.vs-shorts-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7em; }
	.vs-short-title {
		font-family: 'Bricolage Grotesque', sans-serif; color: var(--heading);
		font-size: 0.85em; line-height: 1.3; margin: 0.5em 0 0;
	}
	@media (max-width: 760px) {
		.vs-layout { grid-template-columns: 1fr; }
	}
</style>
