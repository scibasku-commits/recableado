<script is:inline>
(function(){
  var root=document.getElementById('root');
  var LANG='es';
  var KEY='ai-costa-taller-prefs-'+LANG;
  var state={ses:'1',notes:false};

  try{
    var raw=localStorage.getItem(KEY);
    if(raw){var p=JSON.parse(raw);
      if(['1','2','3'].indexOf(p.ses)>-1) state.ses=p.ses;
      if(typeof p.notes==='boolean') state.notes=p.notes;
    }
  }catch(e){}

  var notesBtn=document.getElementById('notesToggle'),
      navBtns=[].slice.call(document.querySelectorAll('.sesnav button')),
      copyBtns=[].slice.call(document.querySelectorAll('.copy'));

  copyBtns.forEach(function(b){b.setAttribute('aria-live','polite');});

  function save(){ try{ localStorage.setItem(KEY,JSON.stringify(state)); }catch(e){} }

  function render(){
    root.className='wrap lang-'+LANG+' ses-'+state.ses+(state.notes?'':' hide-notes');
    notesBtn.setAttribute('aria-pressed',state.notes?'true':'false');
    navBtns.forEach(function(b){
      b.setAttribute('aria-pressed',b.dataset.go===state.ses?'true':'false');
    });
    document.documentElement.lang=LANG;
  }

  notesBtn.addEventListener('click',function(){state.notes=!state.notes;render();save();});
  navBtns.forEach(function(b){
    b.addEventListener('click',function(){
      state.ses=b.dataset.go;render();save();
      var nav=document.querySelector('.sesnav');
      if(nav) window.scrollTo({top:nav.offsetTop-8,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
    });
  });

  render();

  document.addEventListener('click',function(ev){
    var btn=ev.target.closest ? ev.target.closest('.copy') : null;
    if(!btn) return;
    var pre=btn.closest('.prompt').querySelector('pre');
    var text=pre.textContent;
    var label=LANG==='es'?'Copiado':'Copied';
    var errorLabel=LANG==='es'?'No copiado':'Not copied';
    var old=btn.textContent;
    var done=function(){
      btn.textContent=label;btn.classList.add('ok');
      setTimeout(function(){btn.textContent=old;btn.classList.remove('ok');},1400);
    };
    var failed=function(){
      btn.textContent=errorLabel;btn.classList.add('err');
      setTimeout(function(){btn.textContent=old;btn.classList.remove('err');},1800);
    };
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done,function(){fb(text,done,failed);});
    }else{ fb(text,done,failed); }
  });
  function fb(text,cb,fail){
    var ta=document.createElement('textarea');
    ta.value=text;ta.style.position='fixed';ta.style.opacity='0';
    document.body.appendChild(ta);ta.select();
    var copied=false;
    try{copied=document.execCommand('copy');}catch(e){}
    document.body.removeChild(ta);
    if(copied){cb();}else{fail();}
  }
})();
</script>
</body>
