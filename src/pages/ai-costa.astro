<meta name="twitter:title" content="AI Costa · Curso y taller de ChatGPT">
<meta name="twitter:description" content="Tres clases con replays, PDF y certificado, más un taller práctico para pasar de preguntar a construir.">
<meta name="twitter:image" content="https://recableado.blog/ai-costa-social.png">

<style is:inline>
@font-face{font-family:"Bricolage AI Costa";src:url("/fonts/BricolageGrotesque-Regular.ttf") format("truetype");font-weight:400;font-display:swap}
@font-face{font-family:"Bricolage AI Costa";src:url("/fonts/BricolageGrotesque-Bold.ttf") format("truetype");font-weight:700 900;font-display:swap}
:root{
  --paper:#f8f9fa; --surface:#ffffff; --surface-2:#e2e8f0;
  --ink:#2d3748; --ink-2:#2d3748; --ink-3:#0d2847;
  --rule:#e2e8f0; --rule-strong:#d4af37;
  --accent:#1fb4d1; --accent-soft:#e2e8f0; --accent-ink:#0d2847; --accent-text:#0d2847; --on-accent:#0a1628; --focus:#0d2847;
  --flag:#d4af37; --flag-soft:#e2e8f0;
  --hero-a:#0a1628; --hero-b:#0d2847; --hero-text:#ffffff; --hero-muted:#b8c5d6;
  --mono:SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
  --display:"Bricolage AI Costa","Avenir Next","Helvetica Neue",Arial,sans-serif;
  --body:Charter,"Iowan Old Style",Georgia,"Times New Roman",serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0a1628; --surface:#0d2847; --surface-2:#0a1628;
    --ink:#ffffff; --ink-2:#b8c5d6; --ink-3:#b8c5d6;
    --rule:#b8c5d6; --rule-strong:#d4af37;
    --accent:#1fb4d1; --accent-soft:#0d2847; --accent-ink:#ffffff; --accent-text:#1fb4d1; --on-accent:#0a1628; --focus:#d4af37;
    --flag:#d4af37; --flag-soft:#0d2847;
  }
}
:root[data-theme="dark"]{
  --paper:#0a1628; --surface:#0d2847; --surface-2:#0a1628;
  --ink:#ffffff; --ink-2:#b8c5d6; --ink-3:#b8c5d6;
  --rule:#b8c5d6; --rule-strong:#d4af37;
  --accent:#1fb4d1; --accent-soft:#0d2847; --accent-ink:#ffffff; --accent-text:#1fb4d1; --on-accent:#0a1628; --focus:#d4af37;
  --flag:#d4af37; --flag-soft:#0d2847;
}

*{box-sizing:border-box}
html{overflow-x:hidden;background:var(--paper);color-scheme:light dark;scroll-behavior:smooth}
body{overflow-x:hidden;margin:0;min-width:320px;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
::selection{background:var(--accent);color:var(--on-accent)}
*{scrollbar-color:var(--accent) var(--surface-2);scrollbar-width:thin}
*::-webkit-scrollbar{width:10px;height:10px}
*::-webkit-scrollbar-track{background:var(--surface-2)}
*::-webkit-scrollbar-thumb{background:var(--accent);border:2px solid var(--surface-2)}
button{-webkit-tap-highlight-color:transparent}
.wrap{max-width:1000px;margin:0 auto;padding:0 max(28px,env(safe-area-inset-right)) 96px max(28px,env(safe-area-inset-left))}
@media(max-width:640px){.wrap{padding:0 max(18px,env(safe-area-inset-right)) max(64px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))}}

/* ---- language / session switching ---- */
.pane{display:none}
.t{display:none}
.wrap.lang-es .t[data-lang="es"],.wrap.lang-en .t[data-lang="en"]{display:inline}
.wrap.lang-es .pane.always[data-lang="es"],.wrap.lang-en .pane.always[data-lang="en"]{display:block}
.wrap.lang-es.ses-1 .pane[data-lang="es"][data-ses="1"],
.wrap.lang-es.ses-2 .pane[data-lang="es"][data-ses="2"],
.wrap.lang-es.ses-3 .pane[data-lang="es"][data-ses="3"],
.wrap.lang-en.ses-1 .pane[data-lang="en"][data-ses="1"],
.wrap.lang-en.ses-2 .pane[data-lang="en"][data-ses="2"],
.wrap.lang-en.ses-3 .pane[data-lang="en"][data-ses="3"]{display:block}

/* ---- top bar ---- */
.topbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:20px 0 0}
.brand{font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3)}
.ctrls{display:flex;gap:8px;flex-wrap:wrap}
.btn{min-height:44px;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;background:var(--surface);color:var(--ink-2);border:1px solid var(--rule-strong);border-radius:2px;padding:9px 13px;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:color .15s,border-color .15s,background .15s}
.btn:hover{color:var(--ink);border-color:var(--ink-2)}
.btn:active{background:var(--accent-soft)}
.btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.btn .led{width:7px;height:7px;border-radius:50%;background:var(--rule-strong)}
.btn[aria-pressed="true"] .led{background:var(--accent)}
.langsw{display:inline-flex;border:1px solid var(--rule-strong);border-radius:2px;overflow:hidden}
.langsw a{min-width:44px;min-height:44px;display:grid;place-items:center;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;background:var(--surface);color:var(--ink-3);border:0;padding:9px 12px;cursor:pointer;text-decoration:none;transition:background .15s,color .15s}
.langsw a+a{border-left:1px solid var(--rule-strong)}
.langsw a[aria-current="page"]{background:var(--accent);color:var(--on-accent)}
.langsw a:focus-visible{outline:2px solid var(--focus);outline-offset:-2px}
@media(max-width:640px){.topbar{align-items:stretch}.brand{flex:1 0 100%}.ctrls{width:100%;justify-content:space-between}.btn{flex:1;justify-content:center}}

/* ---- masthead ---- */
.mast{border-bottom:2px solid var(--ink);padding:26px 0 22px;display:flex;flex-direction:column;gap:18px}
.kicker{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2);display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center}
.kicker .dot{color:var(--accent)}
h1{font-family:var(--display);font-weight:800;font-size:clamp(2.2rem,6.2vw,4rem);line-height:.97;letter-spacing:-.03em;margin:0;text-wrap:balance}
h1 em{font-style:normal;color:var(--accent-text)}
.standfirst{font-size:1.14rem;color:var(--ink-2);max-width:60ch;margin:0;line-height:1.55}

/* ---- session nav ---- */
.sesnav{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--rule);margin-bottom:4px}
@media(max-width:640px){.sesnav{grid-template-columns:1fr}}
.sesnav button{min-height:82px;text-align:left;background:none;border:0;border-right:1px solid var(--rule);border-top:3px solid transparent;padding:16px 20px 16px 0;cursor:pointer;color:var(--ink-3);font-family:var(--body);transition:color .15s,border-color .15s,background .15s}
.sesnav button:last-child{border-right:0}
@media(max-width:640px){.sesnav button{border-right:0;border-bottom:1px solid var(--rule);padding-right:0}}
.sesnav button:hover{color:var(--ink)}
.sesnav button:active{background:var(--accent-soft)}
.sesnav button:focus-visible{outline:2px solid var(--focus);outline-offset:-3px}
.sesnav button[aria-pressed="true"]{border-top-color:var(--accent);color:var(--ink)}
.sesnav .n{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:5px;color:var(--ink-3)}
.sesnav button[aria-pressed="true"] .n{color:var(--accent-text)}
.sesnav .ttl{font-family:var(--display);font-weight:700;font-size:1.02rem;letter-spacing:-.015em;display:block;line-height:1.25}

.spec{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--rule)}
@media(max-width:720px){.spec{grid-template-columns:repeat(2,1fr)}}
.spec div{padding:18px 20px 18px 0;border-right:1px solid var(--rule)}
.spec div:last-child{border-right:0}
@media(max-width:720px){.spec div:nth-child(2n){border-right:0}.spec div{padding-right:16px}}
.spec dt{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px}
.spec dd{margin:0;font-family:var(--display);font-weight:700;font-size:1.02rem;letter-spacing:-.01em}

section{padding-top:52px}
h2{font-family:var(--display);font-weight:700;font-size:clamp(1.5rem,3.4vw,2.05rem);letter-spacing:-.022em;margin:0 0 6px;text-wrap:balance}
.sec-label{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-text);margin-bottom:12px}
.lede{color:var(--ink-2);max-width:66ch;margin:0 0 26px}
p{max-width:66ch}

.run{display:flex;flex-direction:column;border-top:1px solid var(--rule)}
.block{display:grid;grid-template-columns:96px 1fr;gap:0 28px;border-bottom:1px solid var(--rule);padding:26px 0}
@media(max-width:640px){.block{grid-template-columns:1fr;gap:10px}}
.clock{font-family:var(--mono);font-size:12px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--ink);padding-top:4px}
.clock span{display:block;font-weight:400;color:var(--ink-3);margin-top:3px;font-size:11px}
@media(max-width:640px){.clock{display:flex;gap:12px;align-items:baseline}.clock span{margin-top:0}}
.block h3{font-family:var(--display);font-weight:700;font-size:1.22rem;letter-spacing:-.015em;margin:0 0 8px}
.block h3 .tag{font-family:var(--mono);font-size:9.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;vertical-align:middle;margin-left:10px;padding:3px 7px;border-radius:2px;background:var(--accent-soft);color:var(--accent-ink)}
.block h3 .tag.do{background:var(--flag-soft);color:var(--flag)}
.block p{margin:0 0 12px}
.block ul{margin:0 0 12px;padding-left:20px;max-width:66ch}
.block li{margin-bottom:5px}
.block li::marker{color:var(--accent-text)}

.note{border-left:3px solid var(--flag);background:var(--flag-soft);padding:13px 16px;margin:14px 0 0;max-width:66ch;font-size:.94rem;color:var(--ink)}
.note b{font-family:var(--mono);font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);display:block;margin-bottom:5px;font-weight:700}
.note p{margin:0;max-width:none}
.wrap.hide-notes .note{display:none}

.prompt{background:var(--surface);border:1px solid var(--rule-strong);margin:16px 0;overflow:hidden}
.prompt-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 14px;border-bottom:1px solid var(--rule);background:var(--surface-2)}
.prompt-name{font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
.copy{min-width:72px;min-height:44px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;background:var(--surface);border:1px solid var(--rule-strong);border-radius:2px;color:var(--ink-2);padding:8px 12px;cursor:pointer;white-space:nowrap;transition:color .15s,border-color .15s,background .15s}
.copy:hover{color:var(--accent-text);border-color:var(--accent)}
.copy:active{background:var(--accent-soft)}
.copy:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.copy.ok{color:var(--accent-text);border-color:var(--accent);background:var(--accent-soft)}
.copy.err{color:var(--ink-3);border-color:var(--flag);background:var(--flag-soft)}
.prompt pre{margin:0;padding:15px 16px;overflow-x:auto;font-family:var(--mono);font-size:13.5px;line-height:1.72;white-space:pre-wrap;color:var(--ink)}
@media(max-width:640px){.prompt-head{align-items:flex-start;padding:9px 10px}.prompt-name{padding-top:4px}.prompt pre{font-size:13px;padding:14px 12px}}

code{font-family:var(--mono);font-size:.86em;background:var(--surface-2);padding:1px 5px;border-radius:2px}

.shift{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--rule-strong);margin:22px 0}
@media(max-width:640px){.shift{grid-template-columns:1fr}}
.shift > div{padding:20px 22px}
.shift > div:first-child{border-right:1px solid var(--rule-strong);color:var(--ink-2)}
@media(max-width:640px){.shift > div:first-child{border-right:0;border-bottom:1px solid var(--rule-strong)}}
.shift h4{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 10px;color:var(--ink-3)}
.shift > div:last-child h4{color:var(--accent)}
.shift strong{font-family:var(--display);font-weight:700;font-size:1.5rem;display:block;letter-spacing:-.02em;margin-bottom:8px}
.shift p{margin:0;font-size:.97rem}

.scale{display:flex;gap:0;margin:22px 0;border:1px solid var(--rule-strong);overflow-x:auto}
.scale div{flex:1 1 0;min-width:150px;padding:20px;border-right:1px solid var(--rule)}
.scale div:last-child{border-right:0;background:var(--accent-soft)}
.scale b{display:block;font-family:var(--display);font-weight:800;font-size:1.75rem;letter-spacing:-.03em;font-variant-numeric:tabular-nums;margin-bottom:4px}
.scale div:last-child b{color:var(--accent-ink)}
.scale span{font-family:var(--mono);font-size:11px;color:var(--ink-2);line-height:1.5;display:block}

.tablewrap{overflow-x:auto;margin:20px 0;border:1px solid var(--rule-strong)}
table{border-collapse:collapse;width:100%;min-width:520px;background:var(--surface)}
th{font-family:var(--mono);font-size:10px;letter-spacing:.13em;text-transform:uppercase;text-align:left;padding:11px 15px;color:var(--ink-3);border-bottom:1px solid var(--rule-strong);background:var(--surface-2)}
td{padding:12px 15px;border-bottom:1px solid var(--rule);font-size:.96rem;vertical-align:top}
tr:last-child td{border-bottom:0}
td:first-child{font-family:var(--mono);font-size:12px;color:var(--ink)}

.check{list-style:none;padding:0;margin:18px 0;display:grid;gap:2px}
.check li{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:start;padding:11px 0;border-bottom:1px solid var(--rule);max-width:none}
.check li:last-child{border-bottom:0}
.check .box{width:13px;height:13px;border:1.5px solid var(--rule-strong);margin-top:6px;flex:none}
.check b{font-family:var(--display);font-weight:700;letter-spacing:-.01em}
.check span{display:block;color:var(--ink-2);font-size:.95rem}

.outro{border-top:2px solid var(--ink);margin-top:64px;padding-top:24px;font-family:var(--mono);font-size:11.5px;line-height:1.8;color:var(--ink-2);display:flex;flex-wrap:wrap;gap:8px 32px;justify-content:space-between}
.pull{font-family:var(--display);font-weight:500;font-size:clamp(1.3rem,3vw,1.75rem);line-height:1.28;letter-spacing:-.02em;border-left:3px solid var(--flag);padding:4px 0 4px 22px;margin:30px 0;max-width:28ch;color:var(--ink);text-wrap:balance}
.opening{margin:28px 0 0;padding:clamp(22px,5vw,42px);background:linear-gradient(135deg,var(--hero-a),var(--hero-b));color:var(--hero-text);border:1px solid var(--flag);border-radius:14px;box-shadow:0 18px 44px var(--surface-2)}
.opening .date{font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--flag);margin-bottom:16px}
.opening h2{font-size:clamp(1.8rem,4.6vw,3rem);line-height:1.02;margin-bottom:12px;color:var(--hero-text)}
.opening p{max-width:68ch;color:var(--hero-muted);margin:0}
.opening strong{color:var(--hero-text)}
.pricebar{display:grid;grid-template-columns:repeat(4,1fr);margin-top:28px;border-top:1px solid var(--hero-muted);border-bottom:1px solid var(--hero-muted)}
.pricebar div{padding:14px 16px 14px 0;border-right:1px solid var(--hero-muted)}
.pricebar div+div{padding-left:16px}
.pricebar div:last-child{border-right:0}
.pricebar b{display:block;font-family:var(--display);font-size:1.25rem;color:var(--hero-text)}
.pricebar span{display:block;font-family:var(--mono);font-size:10px;line-height:1.45;color:var(--hero-muted)}
@media(max-width:640px){.opening{border-radius:12px}.pricebar{grid-template-columns:repeat(2,1fr)}.pricebar div:nth-child(2){border-right:0}.pricebar div:nth-child(-n+2){border-bottom:1px solid var(--hero-muted)}.pricebar div:nth-child(3){padding-left:0}}
.five-parts td:first-child{width:36%;font-family:var(--display);font-size:1rem;font-weight:700}
.compare-label{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px}
.compare .prompt{margin:0}
.steps{list-style:none;padding:0;margin:24px 0;counter-reset:steps}
.steps li{counter-increment:steps;display:grid;grid-template-columns:36px 1fr;gap:14px;padding:16px 0;border-bottom:1px solid var(--rule);max-width:70ch}
.steps li::before{content:counter(steps);width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--flag);border-radius:50%;font-family:var(--mono);font-size:11px;font-weight:700;color:var(--accent-ink)}
.steps b{font-family:var(--display)}
.steps span{display:block;color:var(--ink-2)}
.faq{margin-top:24px;border-top:2px solid var(--ink)}
.faq details{border-bottom:1px solid var(--rule)}
.faq summary{min-height:52px;display:flex;align-items:center;cursor:pointer;font-family:var(--display);font-weight:700;font-size:1.08rem;list-style:none}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';margin-left:auto;font-family:var(--mono);color:var(--accent-text)}
.faq details[open] summary::after{content:'−'}
.faq details p{margin:0 0 18px;color:var(--ink-2)}
.faq summary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}
.source-note{font-family:var(--mono);font-size:10.5px;line-height:1.6;color:var(--ink-3)}
.opening .source-note{margin-top:14px;color:var(--hero-muted)}
.opening .source-note a{color:var(--hero-text);text-decoration-color:var(--flag)}
a{color:var(--accent-text);text-underline-offset:3px}
a:focus-visible{outline:2px solid var(--focus);outline-offset:3px}
.course-library{padding:34px 0 42px;border-bottom:2px solid var(--ink)}
.course-library .lede{margin-bottom:22px}
.course-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.course-card{display:flex;flex-direction:column;min-width:0;padding:20px;border:1px solid var(--rule-strong);border-top:4px solid var(--accent);background:var(--surface)}
.course-day{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-text);margin-bottom:8px}
.course-card h3{font-family:var(--display);font-size:1.2rem;line-height:1.2;letter-spacing:-.015em;margin:0 0 10px}
.course-card p{font-size:.94rem;line-height:1.52;color:var(--ink-2);margin:0 0 18px}
.course-links{display:grid;gap:8px;margin-top:auto}
.course-link{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 12px;border:1px solid var(--rule-strong);background:var(--paper);font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none}
.course-link:hover{border-color:var(--accent);color:var(--ink)}
.certificate{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:14px;padding:18px 20px;border:1px solid var(--flag);border-left:4px solid var(--flag);background:var(--flag-soft)}
.certificate strong{display:block;font-family:var(--display);font-size:1.08rem}
.certificate span{display:block;color:var(--ink-2);font-size:.92rem}
.certificate .course-link{flex:0 0 auto}
