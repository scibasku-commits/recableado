<div class="pane" data-lang="en" data-ses="3">
<dl class="spec">
  <div><dt>Idea</dt><dd>Save what works</dd></div>
  <div><dt>Format</dt><dd>Reusable assignment</dd></div>
  <div><dt>Test</dt><dd>Normal + exception</dd></div>
  <div><dt>Leave with</dt><dd>A procedure</dd></div>
