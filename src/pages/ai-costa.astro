---
export const prerender = true;
---
<!doctype html>
<html lang="es" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#0a1628">
<meta name="robots" content="index,follow">
<title>AI Costa · Curso y taller de ChatGPT</title>
<meta name="description" content="Las tres clases de El Nuevo ChatGPT con sus replays, PDF oficiales y certificado, más un taller práctico y bilingüe para pasar de preguntar a construir.">
<link rel="canonical" href="https://recableado.blog/ai-costa/">
