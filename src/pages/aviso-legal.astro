---
// Página legal generada a partir del modelo ya publicado en skialpes.es.
// Los datos fiscales están copiados literalmente de ahí; nada se inventa.
export const prerender = true;
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---
<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Aviso Legal - Recableado" description="Aviso Legal de recableado.blog." lang="es" />
		<meta name="robots" content="noindex, follow" />
		<style is:global>
.lg-wrap{--lg-bg:#fffaf0;--lg-text:#2d3748;--lg-strong:#1a365d;--lg-muted:#718096;--lg-accent:#2b6cb0;--lg-line:#eee8dd;--lg-th:#f6f1e6}

.lg-wrap{max-width:820px;margin:0 auto;padding:56px 24px 80px;line-height:1.7;
  color:var(--lg-text);font-size:16px}
.lg-wrap .lg-kicker{font-size:11px;letter-spacing:.26em;text-transform:uppercase;
  color:var(--lg-accent);margin:0 0 10px}
.lg-wrap h1{font-size:clamp(26px,4vw,38px);color:var(--lg-strong);margin:0 0 8px;line-height:1.2}
.lg-wrap .lg-sub{color:var(--lg-muted);font-size:14px;margin:0 0 32px;
  padding-bottom:24px;border-bottom:1px solid var(--lg-line)}
.lg-wrap h2{font-size:clamp(18px,2.6vw,22px);color:var(--lg-strong);margin:36px 0 12px;
  border-left:3px solid var(--lg-accent);padding-left:12px;line-height:1.3}
.lg-wrap h3{font-size:17px;color:var(--lg-strong);margin:26px 0 10px}
.lg-wrap p{margin:0 0 14px}
.lg-wrap ul{margin:0 0 16px;padding-left:22px}
.lg-wrap li{margin:0 0 8px}
.lg-wrap strong{color:var(--lg-strong)}
.lg-wrap .lg-a{color:var(--lg-accent);text-decoration:underline}
.lg-wrap .lg-pend{border-left:3px solid #e0a800;background:rgba(224,168,0,.08);
  padding:12px 14px;margin:0 0 16px;border-radius:0 4px 4px 0}
.lg-wrap .lg-tw{overflow-x:auto;margin:0 0 18px}
.lg-wrap .lg-t{width:100%;border-collapse:collapse;font-size:13px;border:1px solid var(--lg-line)}
.lg-wrap .lg-t th{text-align:left;padding:8px;background:var(--lg-th);color:var(--lg-strong);
  font-weight:600;border-bottom:1px solid var(--lg-line)}
.lg-wrap .lg-t td{padding:8px;border-top:1px solid var(--lg-line);vertical-align:top}
.lg-wrap .lg-t code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.lg-wrap .lg-hr{border:0;border-top:1px solid var(--lg-line);margin:36px 0 18px}
.lg-wrap .lg-foot{font-size:13px;color:var(--lg-muted)}
.lg-back{display:inline-block;margin-bottom:24px;font-size:13px;color:var(--lg-accent);
  text-decoration:none}

		</style>
	</head>
	<body>
		<Header lang="es" />
		<main>
<article class="lg-wrap">
<p class="lg-kicker">Legal</p>
<h1>Aviso Legal</h1>
<p class="lg-sub">Condiciones generales de uso del sitio web recableado.blog</p>
<p><strong>Giora Gilead Elenberg</strong>, con domicilio en calle Gonzalo D&iacute;az de Valderas, casa 60, Urbanizaci&oacute;n Bella Vista fase 2, 29603 Marbella (M&aacute;laga), con DNI 00829669J, es el titular del sitio web <strong>recableado.blog</strong> y publica en &eacute;l un blog personal sobre tecnolog&iacute;a e inteligencia artificial, de car&aacute;cter divulgativo.</p>
<p class="lg-pend"><strong>[PENDIENTE]</strong> recableado.blog no es un sitio de agencia de viajes y por eso <strong>no se acoge aqu&iacute; a la licencia CICMA</strong> ni al seguro de responsabilidad civil de Viajes Scibasku. Queda por confirmar con el asesor fiscal bajo qu&eacute; ep&iacute;grafe y con qu&eacute; datos de facturaci&oacute;n se declara esta actividad, y ese dato debe sustituir a este p&aacute;rrafo antes de publicar.</p>
<p>Las presentes condiciones generales rigen &uacute;nica y exclusivamente el uso del sitio web recableado.blog por parte de los USUARIOS que accedan al mismo. El acceso al sitio web implica sin reservas la aceptaci&oacute;n de las presentes condiciones generales de uso, que el USUARIO afirma comprender en su totalidad. El USUARIO se compromete a no utilizar el sitio web y los servicios que se ofrecen en el mismo para la realizaci&oacute;n de actividades contrarias a la ley y a respetar en todo momento las presentes condiciones generales.</p>
