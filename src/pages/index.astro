---
export const prerender = true;
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ChatHero from '../components/ChatHero.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';
import PostStatsLoader from '../components/PostStatsLoader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
const posts = (await getCollection('blogEs')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);

function getReadingTime(body: string | undefined): number {
	return body ? Math.max(1, Math.ceil(body.split(/\s+/).length / 200)) : 5;
}
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} lang={lang} />
	</head>
	<body class="darkroom-page">
		<!--
		THESIS: Recableado abre como una secuencia de planos elegidos, no como una plantilla de blog ni un tablero de tarjetas.
		OWN-WORLD: negro tinta con luz de sala, imagen casi monocroma, marfil para lectura y naranja brasa como unico acento.
		STORY: el lector reconoce a Giora, entra en la historia mas reciente y descubre las anteriores sin perder orientacion.
		FIRST VIEWPORT: el ultimo articulo ocupa el encuadre completo; imagen a sangre, titulo grande abajo a la izquierda y acceso de lectura junto a el.
		FORM: Sala oscura fijada por el usuario; seed eac30581.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		<Header lang={lang} />
		<main class="darkroom-home">
			{featuredPost && (
				<a
					href={`/blog/${featuredPost.id}/`}
					class="lead-story"
					data-slug={featuredPost.id}
					aria-label={`Leer: ${featuredPost.data.title}`}
				>
					<div class="lead-visual" aria-hidden="true">
						{featuredPost.data.heroImage ? (
							<Image
								src={featuredPost.data.heroImage}
								alt=""
								loading="eager"
								fetchpriority="high"
							/>
						) : (
							<div class="story-fallback story-fallback--lead">
								<span>Recableado</span>
							</div>
						)}
					</div>
					<div class="lead-shade" aria-hidden="true"></div>
					<div class="lead-copy">
						<p class="story-meta">
							<FormattedDate date={featuredPost.data.pubDate} lang={lang} />
							<span aria-hidden="true"> · </span>
							{getReadingTime(featuredPost.body)} {t('blog.minRead') as string}
						</p>
						<h1>{featuredPost.data.title}</h1>
						<p class="lead-description">{featuredPost.data.description}</p>
						<span class="story-action">
							Leer el artículo
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h13M13 6l6 6-6 6" />
							</svg>
						</span>
					</div>
				</a>
			)}

			<section class="edit-strip" aria-labelledby="edit-strip-title">
				<div class="section-heading">
					<h2 id="edit-strip-title">La historia continúa</h2>
					<a href="/blog/">Ver todos los artículos</a>
				</div>
				<div class="edit-grid">
					{recentPosts.map((post) => (
						<a href={`/blog/${post.id}/`} class="story-card" data-slug={post.id}>
							<div class="card-visual" aria-hidden="true">
								{post.data.heroImage ? (
									<Image src={post.data.heroImage} alt="" loading="lazy" />
								) : (
									<div class="story-fallback">
										<span>Recableado</span>
										<strong>{post.data.title}</strong>
									</div>
								)}
							</div>
							<div class="card-copy">
								<p class="story-meta">
									<FormattedDate date={post.data.pubDate} lang={lang} />
									<span aria-hidden="true"> · </span>
									{getReadingTime(post.body)} {t('blog.minRead') as string}
								</p>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="manifest" aria-labelledby="manifest-title">
				<div class="manifest-frame" aria-hidden="true">
					<span>1954</span>
					<span>2006</span>
					<span>2025</span>
					<span>Ahora</span>
				</div>
				<div class="manifest-copy">
					<h2 id="manifest-title">No aprendí inteligencia artificial para parecer más joven.</h2>
					<p class="manifest-answer">La aprendí porque todavía me quedaban cosas por hacer.</p>
					<p>Tengo 73 años, llevo más de cuarenta vendiendo viajes y sigo entrando en cada herramienta nueva como quien llega a un país sin mapa. Aquí cuento lo que funciona, lo que rompo y lo que aprendo por el camino.</p>
					<a href="/about/" class="text-link">La historia completa</a>
				</div>
			</section>

			<section class="darkroom-chat" aria-label="Habla con el asistente de Giora">
				<ChatHero lang={lang} />
			</section>

			<section class="closing-frame">
				<p>Los descubrimientos, los desastres y las noches en que una máquina volvió a darme una idea.</p>
				<a href="/blog/" class="closing-link">
					Entrar en el archivo
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
				</a>
			</section>
		</main>
		<Footer lang={lang} />
		<Lightbox />
		<PostStatsLoader />
	</body>
</html>

<style is:global>
	.darkroom-page {
		--bg: #08090a;
		--text: #ece9e2;
		--heading: #fffdf7;
		--azul-medio: #b6b2aa;
		--link: #ff5e24;
		--link-hover: #ff8a5e;
		--naranja: #ff5e24;
		--gray: #aaa69e;
		--gray-light: #1b1d1f;
		--border: #2e3032;
		background:
			radial-gradient(circle at 14% -8%, rgba(255, 255, 255, 0.06), transparent 34rem),
			#08090a;
		color: var(--text);
	}

	.darkroom-page main.darkroom-home {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
		overflow: clip;
	}

	.darkroom-page header {
		position: relative;
		z-index: 10;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.darkroom-page header hr {
		display: none;
	}

	.lead-story {
		position: relative;
		display: grid;
		min-height: min(840px, calc(100svh - 148px));
		isolation: isolate;
		color: #fffdf7;
		text-decoration: none;
		background: #0b0c0d;
		overflow: hidden;
	}

	.lead-visual,
	.lead-shade,
	.lead-copy {
		grid-area: 1 / 1;
	}

	.lead-visual,
	.lead-visual picture,
	.lead-visual img {
		width: 100%;
		height: 100%;
		min-height: inherit;
	}

	.lead-visual img {
		display: block;
		object-fit: cover;
		object-position: center 48%;
		border-radius: 0;
		filter: grayscale(0.92) saturate(0.3) contrast(1.08) brightness(0.72);
	}

	.lead-shade {
		z-index: 1;
		background:
			linear-gradient(90deg, rgba(3, 4, 5, 0.82) 0%, rgba(3, 4, 5, 0.3) 58%, rgba(3, 4, 5, 0.08) 100%),
			linear-gradient(0deg, rgba(3, 4, 5, 0.92) 0%, transparent 62%);
	}

	.lead-copy {
		position: relative;
		z-index: 2;
		align-self: end;
		box-sizing: border-box;
		width: min(100%, 1440px);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 5rem) clamp(1.25rem, 6vw, 6rem);
	}

	.story-meta {
		margin: 0 0 1rem;
		color: #ffb093;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: 0.86rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.lead-copy h1 {
		max-width: 13ch;
		margin: 0;
		color: #fffdf7;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: clamp(3.2rem, 7vw, 6rem);
		line-height: 0.96;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.lead-description {
		max-width: 63ch;
		margin: 1.5rem 0 1.75rem;
		color: #e7e2d9;
		font-size: clamp(1.06rem, 1rem + 0.3vw, 1.25rem);
		line-height: 1.55;
	}

	.story-action,
	.closing-link {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 44px;
		color: #ff7a48;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-weight: 700;
	}

	.story-action svg,
	.closing-link svg {
		width: 1.35rem;
		height: 1.35rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
	}

	.edit-strip {
		padding: clamp(4.5rem, 9vw, 9rem) clamp(1.25rem, 6vw, 6rem);
		background: #0b0c0d;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		width: min(100%, 1320px);
		margin: 0 auto 2rem;
	}

	.section-heading h2 {
		margin: 0;
		color: #fffdf7;
		font-size: clamp(2rem, 4vw, 4.4rem);
		letter-spacing: -0.025em;
	}

	.section-heading a,
	.text-link {
		color: #ff7a48;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-weight: 700;
		text-underline-offset: 0.25em;
	}

	.edit-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.25rem, 2.5vw, 2.75rem);
		width: min(100%, 1320px);
		margin: 0 auto;
	}

	.story-card {
		display: block;
		min-width: 0;
		color: var(--text);
		text-decoration: none;
		border-top: 1px solid #393b3d;
		padding-top: 1rem;
	}

	.card-visual {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #111315;
	}

	.card-visual picture,
	.card-visual img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.card-visual img {
		object-fit: cover;
		border-radius: 0;
		filter: grayscale(1) contrast(1.05) brightness(0.72);
		transition: filter 260ms ease-out;
	}

	.story-card:hover .card-visual img,
	.story-card:focus-visible .card-visual img {
		filter: grayscale(0.72) contrast(1.06) brightness(0.82);
	}

	.card-copy {
		padding: 1.25rem 0 0;
	}

	.card-copy h3 {
		margin: 0 0 0.75rem;
		color: #fffdf7;
		font-size: clamp(1.35rem, 2vw, 1.9rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.card-copy > p:last-child {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: #c5c1b9;
		font-size: 1rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.story-fallback {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		padding: clamp(1.25rem, 3vw, 2.5rem);
		background:
			radial-gradient(circle at 82% 16%, rgba(255, 94, 36, 0.16), transparent 13rem),
			#111315;
		color: #fffdf7;
	}

	.story-fallback::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: #ff5e24;
	}

	.story-fallback span {
		color: #ff8a5e;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.story-fallback strong {
		max-width: 22ch;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: clamp(1.2rem, 1.55vw, 1.55rem);
		line-height: 1.05;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.story-fallback--lead {
		justify-content: flex-start;
		min-height: inherit;
		padding: clamp(2rem, 6vw, 6rem);
	}

	.manifest {
		display: grid;
		grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
		width: min(calc(100% - 2.5rem), 1320px);
		margin: 0 auto;
		padding: clamp(5rem, 11vw, 11rem) 0;
		border-top: 1px solid #282a2c;
	}

	.manifest-frame {
		display: grid;
		align-content: space-between;
		min-height: 30rem;
		padding-right: clamp(2rem, 6vw, 7rem);
		color: #686a6b;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: clamp(1rem, 1.5vw, 1.45rem);
		font-weight: 600;
	}

	.manifest-frame span:last-child {
		color: #ff7a48;
	}

	.manifest-copy {
		align-self: center;
		max-width: 780px;
	}

	.manifest-copy h2 {
		margin: 0;
		color: #fffdf7;
		font-size: clamp(2.6rem, 5.7vw, 5.8rem);
		line-height: 0.98;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.manifest-answer {
		margin: 2rem 0 2.5rem;
		color: #ff7a48;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: clamp(1.45rem, 2.5vw, 2.2rem);
		font-weight: 600;
		line-height: 1.2;
	}

	.manifest-copy > p:not(.manifest-answer) {
		max-width: 62ch;
		color: #d3cfc7;
		font-size: clamp(1.1rem, 1rem + 0.3vw, 1.25rem);
		line-height: 1.75;
	}

	.darkroom-chat {
		width: min(calc(100% - 2.5rem), 1040px);
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 8rem) 0;
		border-top: 1px solid #282a2c;
	}

	.darkroom-chat .chat-hero-section {
		margin: 0 !important;
		padding: 0 !important;
		background: transparent !important;
	}

	.darkroom-chat .chat-hero-section::before,
	.darkroom-chat .chat-hero-section::after {
		display: none !important;
	}

	.darkroom-chat .chat-hero-box {
		background: #101214 !important;
		border: 1px solid #303235 !important;
		border-radius: 12px !important;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3) !important;
	}

	.darkroom-chat .chat-hero-tagline,
	.darkroom-chat .hcm-bot .hcm-bubble {
		color: #e5e1d9 !important;
	}

	.darkroom-chat .hcm-bot .hcm-bubble,
	.darkroom-chat .chat-hero-input {
		background: #17191b !important;
	}

	.darkroom-chat .chat-hero-input textarea {
		background: #0d0f10 !important;
		color: #fffdf7 !important;
	}

	.darkroom-chat .hc-pill {
		color: #fffdf7 !important;
	}

	.closing-frame {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;
		width: min(calc(100% - 2.5rem), 1320px);
		margin: 0 auto;
		padding: clamp(5rem, 10vw, 10rem) 0;
		border-top: 1px solid #282a2c;
	}

	.closing-frame p {
		max-width: 24ch;
		margin: 0;
		color: #fffdf7;
		font-family: 'Bricolage Grotesque', sans-serif;
		font-size: clamp(2rem, 4.5vw, 4.8rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.closing-link {
		flex: 0 0 auto;
		font-size: 1.1rem;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
	}

	.darkroom-page :focus-visible {
		outline: 2px solid #ff7a48;
		outline-offset: 5px;
	}

	.darkroom-page .rec-footer {
		border-top-color: #282a2c;
	}

	@media (prefers-reduced-motion: no-preference) {
		.lead-copy {
			animation: lead-reveal 680ms cubic-bezier(0.16, 1, 0.3, 1) both;
		}

		.edit-grid {
			animation: strip-reveal 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
			animation-range: entry 0% cover 28%;
			animation-timeline: view();
		}

		@keyframes lead-reveal {
			from { clip-path: inset(0 0 22% 0); filter: blur(5px); }
			to { clip-path: inset(0); filter: blur(0); }
		}

		@keyframes strip-reveal {
			from { opacity: 0.55; transform: translateY(18px); }
			to { opacity: 1; transform: translateY(0); }
		}
	}

	@media (max-width: 820px) {
		.lead-story {
			min-height: 76svh;
		}

		.lead-visual img {
			object-position: 61% center;
		}

		.lead-shade {
			background: linear-gradient(0deg, rgba(3, 4, 5, 0.96) 0%, rgba(3, 4, 5, 0.38) 78%, rgba(3, 4, 5, 0.12) 100%);
		}

		.lead-copy h1 {
			max-width: 12ch;
			font-size: clamp(2.65rem, 12vw, 4.6rem);
		}

		.lead-description {
			display: -webkit-box;
			overflow: hidden;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 3;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}

		.edit-grid {
			grid-template-columns: repeat(3, minmax(78vw, 1fr));
			width: calc(100% + 1.25rem);
			overflow-x: auto;
			overflow-y: hidden;
			padding: 0 1.25rem 1rem 0;
			scroll-snap-type: x mandatory;
			scrollbar-color: #ff5e24 #191b1d;
		}

		.story-card {
			scroll-snap-align: start;
		}

		.manifest {
			grid-template-columns: 1fr;
		}

		.manifest-frame {
			grid-template-columns: repeat(4, auto);
			min-height: 0;
			padding: 0 0 3rem;
			font-size: 0.82rem;
		}

		.closing-frame {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 520px) {
		.edit-strip {
			padding-inline: 1.25rem;
		}

		.story-meta {
			font-size: 0.72rem;
		}

		.lead-copy {
			padding-bottom: 2rem;
		}

		.lead-copy h1 {
			font-size: clamp(2.35rem, 11.7vw, 3.5rem);
		}

		.manifest-copy h2,
		.closing-frame p {
			font-size: clamp(2.2rem, 11vw, 3.4rem);
		}

		.darkroom-chat,
		.manifest,
		.closing-frame {
			width: calc(100% - 2rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.darkroom-page *,
		.darkroom-page *::before,
		.darkroom-page *::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
